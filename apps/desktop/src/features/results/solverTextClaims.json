{
 "about": "Release exit criterion 18 (LIM-026): every diagnostic code of fixtures/diagnostics/exact_route_codes.json, classified by whether its text states a pass, a bound or an established state that rests on the ordinary solve's integrity bound, which SWBPIPE does not verify. 'claim': every message of the code states such a claim, and the note always stands beside it. 'quotes_claim': a message of the code may quote one, recognised by the solver's fixed phrases below. 'no_claim': the code states none; the retained-precision route's and the pressure-source recovery's own certificate texts are here, since another certificate establishes them. A text with no code (a published limitation, a confirmation's quoted detail) and a code outside the table are decided by the phrases. integrityStatusClaims.test.ts fails when a code of the table is not classified here.",
 "phrases": [
  {
   "text": "NUMERICAL_INTEGRITY_CHECKS_PASSED",
   "rests_on": "The solver's checks-passed code, quoted in another text (a prior outcome, a limitation about such cases)."
  },
  {
   "text": "Converged support state: established at 128-bit precision",
   "rests_on": "The solver's confirmed support-state line; its enclosures rest on the integrity bound (DEL-04-01 REQ-016)."
  },
  {
   "text": "separate zero count/cap/contact/sliding checks passed",
   "rests_on": "The nonlinear iteration's equilibrium checks of the ordinary solve, stated as passed."
  },
  {
   "text": "not_required_ordinary_checks_passed",
   "rests_on": "The ordinary solve's checks, stated as passed."
  },
  {
   "text": "derived row group(s) are established within their stated bound",
   "rests_on": "The combination certificate over the operand cases' ordinary member bounds."
  },
  {
   "text": "the case is stress-free to within numerical precision",
   "rests_on": "Row bounds formed from the case's ordinary member bound."
  },
  {
   "text": "only the derived row groups that contract_evidence.combination_certificate establishes carry a stated bound",
   "rests_on": "The combination certificate over the operand cases' ordinary member bounds."
  },
  {
   "text": "Established within its stated numerical bound for the explicitly held system",
   "rests_on": "A held-constraint comparison's outcome E: the held system's support-state confirmation, which rests on the ordinary solve's integrity bound (held_status.rs ESTABLISHED)."
  }
 ],
 "claim": {
  "NUMERICAL_INTEGRITY_CHECKS_PASSED": "The solver's verdict that its integrity checks passed for the case; the check's error bound rests on the inverse-norm step SWBPIPE does not verify.",
  "COMBINATION_ROWS_WITHIN_STATED_BOUND": "Derived row groups established within a bound formed from the operand cases' member bounds, which are the ordinary solve's (formation check over the inverse-norm step).",
  "STRESS_FREE_WITHIN_NUMERICAL_PRECISION": "Row bounds formed from the case's member bound, the ordinary solve's formation-check bound over the inverse-norm step.",
  "EXACT_COMBINATION_DERIVED_FROM_CASE_RESULTS": "Says that the row groups the combination certificate establishes carry a stated bound; that certificate is formed from the operand cases' ordinary member bounds."
 },
 "quotes_claim": {
  "NUMERICAL_INTEGRITY_SENSITIVE": "A demoted checks-passed message keeps the solver's sentences that its equilibrium checks passed and, for a nonlinear case, that its converged support state is established.",
  "NUMERICAL_INTEGRITY_RECOVERY_BASIS_UNQUALIFIED": "The inspection-only message states that the ordinary solve's separate zero count/cap/contact/sliding checks passed.",
  "NUMERICAL_INTEGRITY_INSPECTION_ONLY": "Quotes the case's prior outcome code NUMERICAL_INTEGRITY_CHECKS_PASSED and its integrity message.",
  "LOAD_STATE_SOURCE_RECOVERY_NOT_JOINED": "Its token retained_source_attempt=not_required_ordinary_checks_passed states that the ordinary solve's checks passed."
 },
