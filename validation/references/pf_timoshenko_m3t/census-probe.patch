+                Err(reason) => ("\"B\":null,\"B_bits\":null".into(), "true".into(), text(&format!("the member bound is unavailable ({reason})"))),
+            };
+            groups.push(format!(
+                "{{\"entity\":{},\"body\":{},\"location\":{},\"kind\":{},\"moment\":{},{},{},{b},{},{},{},\"zero_compatible\":{},\"fires\":{fires},\"unavailable\":{unavailable}}}",
+                text(&record.member),
+                record.body.map_or("null".into(), |b| b.to_string()),
+                text(&group.location), text(&group.kind), group.moment,
+                field("q", group.q), field("q_hat", group.q_hat), field("s_star", s_star),
+                field("absolute_scale", group.absolute_scale), field("published_scale", group.published_scale),
+                group.zero_compatible,
+            ));
+        }
+    }
+    let line = format!(
+        "{{\"record\":\"groups\",{},\"case_id\":{},\"eval\":{},\"pre_guard_passed\":{pre_guard_passed},\"load_row_finding\":{load_row_finding},\"member_bound\":{},{},\"groups\":[{}]}}",
+        labels(), text(case_id), last_eval(), bound.is_some(),
+        match bound {
+            Some(b) => field("lambda_sigma", b.lambda_sigma),
+            None => "\"lambda_sigma\":null,\"lambda_sigma_bits\":null".into(),
+        },
+        groups.join(","),
+    );
+    write(&line);
+}
