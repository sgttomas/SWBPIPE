+    use open_pipe_stress_frame_kernel::kd5_probe::{field, labels, last_eval, text, write};
+    let scales = member_scales(records, bodies);
+    let mut groups = Vec::new();
+    for record in records {
+        let body_scales = record.body.and_then(|body| scales.get(&body).copied()).unwrap_or_default();
