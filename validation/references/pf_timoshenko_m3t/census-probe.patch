index 0000000000000000000000000000000000000000..725cd7a992517eff22d953bb326345c80955a6e0
--- /dev/null
+++ b/projects/chirality-piping/core/solver/frame_kernel/src/kd5_probe.rs
@@ -0,0 +1,94 @@
+//! K-D5 census probe: test-only instrumentation, never part of product source
+//! (pf_timoshenko_m3t/census-probe.patch). Active only when `KD5_PROBE_OUT`
+//! names a file; it then appends one JSON line per K-D5 evaluation and per
+//! recovery decision. It reads values the product has already formed (or forms
+//! ε_E again with the product's own function) and writes them; nothing it
+//! computes is returned to the product. Unset, every entry point is a no-op.
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+
+static CASE: Mutex<Option<String>> = Mutex::new(None);
+static EVAL: AtomicU64 = AtomicU64::new(0);
+
+fn path() -> Option<std::ffi::OsString> {
+    std::env::var_os("KD5_PROBE_OUT").filter(|p| !p.is_empty())
+}
+
+pub fn enabled() -> bool {
+    path().is_some()
+}
+
+/// The load case whose solve runs next (set by product_physics).
+pub fn set_case(case: &str) {
+    if enabled() {
+        *CASE.lock().unwrap_or_else(|e| e.into_inner()) = Some(case.to_owned());
+    }
+}
+
+/// A new evaluation's process-wide sequence number (1, 2, ...).
+pub fn next_eval() -> u64 {
+    EVAL.fetch_add(1, Ordering::Relaxed) + 1
+}
+
+/// The last evaluation's sequence number (0 before any).
+pub fn last_eval() -> u64 {
+    EVAL.load(Ordering::Relaxed)
+}
+
+/// A JSON string literal.
+pub fn text(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// A binary64 as a JSON number (shortest round-trip decimal), null if not finite.
+pub fn num(x: f64) -> String {
+    if x.is_finite() {
+        format!("{x:?}")
+    } else {
+        "null".into()
+    }
+}
+
+/// `"name":<decimal>,"name_bits":"<16 hex digits>"`; the bits are always exact.
+pub fn field(name: &str, x: f64) -> String {
+    format!("\"{name}\":{},\"{name}_bits\":\"{:016x}\"", num(x), x.to_bits())
+}
+
+/// The runner's labels and the current load case.
+pub fn labels() -> String {
+    let env = |k: &str| std::env::var(k).ok().map_or("null".into(), |v| text(&v));
+    let case = CASE
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .as_deref()
+        .map_or("null".into(), text);
+    format!(
+        "\"tag\":{},\"entry\":{},\"mode\":{},\"case\":{case}",
+        env("KD5_ACTIVE_TAG"),
+        env("KD5_ACTIVE_ENTRY"),
+        env("KD5_ACTIVE_MODE")
+    )
+}
+
+/// Appends one line; a write failure is ignored (the probe never fails a run).
+pub fn write(line: &str) {
+    if let Some(p) = path() {
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {
+            let mut bytes = line.as_bytes().to_vec();
+            bytes.push(b'\n');
+            let _ = f.write_all(&bytes);
+        }
+    }
+}
