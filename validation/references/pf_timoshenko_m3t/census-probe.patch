+// ------------------------------------------------------- K-D5 census probe
+// census-probe.patch (test-only): what one evaluation formed, written by
+// `check_at` to KD5_PROBE_OUT. Nothing here returns to the product.
+
+/// ε_E's parts, each kept as row and column sums charged with the same upward
+/// values as ε_E itself; a part's norm is the larger of its two sum norms.
+#[derive(Debug, Clone)]
+struct ProbeParts {
+    sums: Vec<(Vec<f64>, Vec<f64>)>,
+}
+impl ProbeParts {
+    const ELEMENTS: usize = 0;
+    const ASSEMBLY: usize = 1;
+    const PROJECTION: usize = 2;
+    const EULER_BERNOULLI: usize = 3;
+    const TIMOSHENKO: usize = 4;
+    const OTHER: usize = 5;
+    fn new(n: usize) -> Self {
+        Self { sums: vec![(vec![0.0; n], vec![0.0; n]); 6] }
+    }
+    fn charge(&mut self, part: usize, r: usize, c: usize, value: f64) {
+        let (rows, cols) = &mut self.sums[part];
+        rows[r] = add_up(rows[r], value);
+        cols[c] = add_up(cols[c], value);
+    }
+    fn norm(&self, part: usize) -> f64 {
+        let (rows, cols) = &self.sums[part];
+        rows.iter().chain(cols).copied().fold(0.0, f64::max)
+    }
+}
+
+#[derive(Debug, Default)]
+struct ProbeTrace {
+    step7: bool,
+    epsilon: Option<f64>,
+    epsilon_source: &'static str,
+    parts: Option<ProbeParts>,
+    sigma: Option<f64>,
+    neumann: Option<f64>,
+    lambda: Option<f64>,
+    lambda_sigma: Option<f64>,
+}
+
+#[allow(clippy::too_many_arguments)]
+fn probe_line<A, P>(
+    system: &StructuralSystem<'_>,
+    source: &FormationSource,
+    scale_exponents: &[i32],
+    condition: (f64, f64, f64),
+    assembled: &A,
+    projected: &P,
+    judged: bool,
+    trace: &ProbeTrace,
+    outcome: &str,
+    check: Option<&FormationCheck>,
+) where
+    A: Fn(usize, usize) -> f64,
+    P: Fn(usize, usize) -> f64,
+{
+    use crate::kd5_probe::{field, labels, next_eval, num, text};
+    let n_free = system.free_dofs.len();
+    let mut epsilon = trace.epsilon;
+    let mut epsilon_source = if epsilon.is_some() { trace.epsilon_source } else { "" };
+    let mut parts = trace.parts.clone();
+    let mut epsilon_error = None;
+    // Before step 7 (or on a cached ε_E) the product formed no parts: form them
+    // with the product's own `epsilon_e` on the same inputs.
+    if parts.is_none() {
+        if source.node_count.checked_mul(DOF_PER_NODE) == Some(system.force.len())
+            && scale_exponents.len() == n_free
+            && system.free_dofs.iter().all(|&i| i < system.force.len())
+        {
+            let mut index = vec![None; system.force.len()];
+            for (r, &i) in system.free_dofs.iter().enumerate() {
+                index[i] = Some(r);
+            }
+            let mut fresh = ProbeParts::new(n_free);
+            let formed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                epsilon_e(system, source, &index, scale_exponents, assembled, projected, Some(&mut fresh))
+            }));
+            match formed {
+                Ok(Ok(value)) => {
+                    if epsilon.is_none() {
+                        epsilon = Some(value);
+                        epsilon_source = "probe";
+                    }
+                    parts = Some(fresh);
+                }
+                Ok(Err(failure)) => epsilon_error = Some(failure.detail()),
+                Err(_) => epsilon_error = Some("probe: epsilon_e panicked".into()),
+            }
+        } else {
+            epsilon_error = Some("probe: DOF map".into());
+        }
+    }
+    let (r_hat, est, norm) = condition;
+    let mut s = format!(
+        "{{\"record\":\"evaluation\",{},\"eval\":{},\"judged\":{judged},\"step7\":{},\"outcome\":{},\"n_free\":{n_free},{},{},{}",
+        labels(), next_eval(), trace.step7, text(outcome),
+        field("r_hat", r_hat), field("est", est), field("norm1_Ks", norm),
+    );
+    match epsilon {
+        Some(e) => {
+            s += &format!(",{},\"epsilon_E_source\":{}", field("epsilon_E", e), text(epsilon_source));
+            let neumann = trace.neumann.unwrap_or_else(|| mul_up(mul_up(1024.0, est), e));
+            s += &format!(",{}", field("neumann_2p10_est_epsE", neumann));
+        }
+        None => s += ",\"epsilon_E\":null,\"epsilon_E_source\":null,\"neumann_2p10_est_epsE\":null",
+    }
+    match &parts {
+        Some(p) => {
+            let three = [ProbeParts::ELEMENTS, ProbeParts::ASSEMBLY, ProbeParts::PROJECTION].map(|k| p.norm(k));
+            s += &format!(
+                ",\"epsilon_E_parts\":[{},{},{}],\"epsilon_E_parts_bits\":[\"{:016x}\",\"{:016x}\",\"{:016x}\"]",
+                num(three[0]), num(three[1]), num(three[2]),
+                three[0].to_bits(), three[1].to_bits(), three[2].to_bits()
+            );
+            s += &format!(
+                ",\"epsilon_E_element_parts\":{{{},{},{}}}",
+                field("euler_bernoulli", p.norm(ProbeParts::EULER_BERNOULLI)),
+                field("timoshenko", p.norm(ProbeParts::TIMOSHENKO)),
+                field("other", p.norm(ProbeParts::OTHER)),
+            );
+        }
+        None => s += ",\"epsilon_E_parts\":null,\"epsilon_E_element_parts\":null",
+    }
+    s += &format!(",\"epsilon_E_error\":{}", epsilon_error.as_deref().map_or("null".into(), text));
+    for (name, value) in [("sigma", trace.sigma), ("lambda", trace.lambda), ("lambda_sigma", trace.lambda_sigma)] {
+        s += &match value {
+            Some(v) => format!(",{}", field(name, v)),
+            None => format!(",\"{name}\":null"),
+        };
+    }
+    s += &match check {
+        Some(c) if c.reason == FormationCheckReason::Estimate => format!(
+            ",\"demotion\":{{\"global_dof\":{},{},{},{}}}",
+            c.global_dof.map_or("null".into(), |d| d.to_string()),
+            field("doubled_correction", c.doubled_correction), field("scale", c.scale), field("ratio", c.ratio),
+        ),
+        _ => ",\"demotion\":null".into(),
+    };
+    s += &format!(
+        ",\"scale_exponents\":[{}]",
+        scale_exponents.iter().map(|e| e.to_string()).collect::<Vec<_>>().join(",")
+    );
+    s += &format!(
+        ",\"elements\":{{\"frames\":{},\"connectors\":{},\"tie_rods\":{},\"curved\":{},\"springs\":{}}}",
+        source.frames.len(), source.connectors.len(),
+        source.connectors.iter().map(|c| c.tie_rods().len()).sum::<usize>(),
+        source.curved.len(), source.springs.len(),
+    );
+    // The resolved section and moduli (Pa, m) each straight member was re-formed with.
+    let frames = source.frames.iter().enumerate().map(|(k, f)| {
+        let x = &f.section;
+        format!(
+            "{{\"member\":{},\"node_i\":{},\"node_j\":{},\"theory\":{},{},{},{},{},{},{},{}}}",
+            source.frame_members.get(k).map_or("null".into(), |m| text(m)),
+            f.node_i.index, f.node_j.index,
+            text(if x.beam_theory.is_timoshenko() { "timoshenko" } else { "euler_bernoulli" }),
+            field("E", x.elastic_modulus), field("G", x.shear_modulus), field("A", x.area),
+            field("Iy", x.second_moment_y), field("Iz", x.second_moment_z), field("J", x.torsion_constant),
+            match x.beam_theory.shear_area() {
+                Some(a) => field("A_s", a),
+                None => "\"A_s\":null".into(),
+            },
+        )
+    });
+    s += &format!(",\"frames\":[{}]", frames.collect::<Vec<_>>().join(","));
+    if n_free <= 160 && scale_exponents.len() == n_free {
+        let rows = (0..n_free).map(|r| {
+            format!("[{}]", (0..n_free).map(|c| num(projected(r, c))).collect::<Vec<_>>().join(","))
+        });
+        s += &format!(",\"Ks\":[{}]", rows.collect::<Vec<_>>().join(","));
+    }
+    s.push('}');
+    crate::kd5_probe::write(&s);
+}
