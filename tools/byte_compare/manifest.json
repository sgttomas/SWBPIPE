  "roots": [
    {
      "pattern": "validation/references/kd5_nonlinear/*_request.json",
      "why": "The K-D5 exact nonlinear references' frozen requests (model document 0.1.0), as kd5_nonlinear_tests.rs consumes them."
    },
    {
      "pattern": "validation/references/w16_nonlinear_motion/requests/*.json",
      "why": "The W16 nonlinear imposed-motion references' frozen requests (model document 0.8.0), as w16_nonlinear_motion_tests.rs consumes them."
    },
    {
      "pattern": "fixtures/product_preview/invented_demo_model.json",
      "why": "A single maintained model or request named by the earlier hand comparison; this root closes its existence only."
    },
    {
      "pattern": "core/product_physics/tests/fixtures/preview_physics_invented_model.json",
      "why": "A single maintained model or request named by the earlier hand comparison; this root closes its existence only."
    },
    {
      "pattern": "core/product_physics/tests/fixtures/preview_physics_range_envelope_model.json",
      "why": "A single maintained model or request named by the earlier hand comparison; this root closes its existence only."
    },
    {
      "pattern": "fixtures/results/modal_state_friction_sliding.request.json",
      "why": "A single maintained model or request named by the earlier hand comparison; this root closes its existence only."
    },
    {
      "pattern": "fixtures/reference_system/reference_system.json",
      "why": "A single maintained model or request named by the earlier hand comparison; this root closes its existence only."
    }
  ],
