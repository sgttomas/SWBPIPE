  "schema_version": "0.1.0",
  "sign_conventions": [
    {
      "sign_convention": "positive_along_axis",
      "statement": "A displacement is positive along its global axis; a rotation is positive by the right-hand rule about its global axis."
    },
    {
      "sign_convention": "action_on_element_at_end_node",
      "statement": "The generalized force acting on the element at its end node, each component positive along the axis of the row's frame; a moment is about the end node, positive by the right-hand rule. For a member or an arc the internal section force at end i is its negative."
    },
    {
      "sign_convention": "positive_along_connector_axes",
      "statement": "A connector's generalized force, positive along its connector axes and work-conjugate to its relative displacements; a moment is positive by the right-hand rule."
    },
    {
      "sign_convention": "tension_positive",
      "statement": "A tie rod's axial force, positive in tension, its axis running from its attachment at end i to its attachment at end j."
    },
    {
      "sign_convention": "action_of_support_on_piping",
      "statement": "The force or moment the support applies to the piping, positive along the global axis; a moment is about the node, positive by the right-hand rule."
    }
  ],
