{
  "schema": "chirality-software-workflow/v1",
  "project_root": ".",
  "workspace_root": ".",
  "checks": {
    "desktop-build": {
      "cwd": ".",
      "command": [
        "npm",
        "run",
        "build:desktop"
      ]
    },
    "desktop-test": {
      "cwd": ".",
      "command": [
        "npm",
        "run",
        "test:desktop"
      ]
    },
    "desktop-rust-test": {
      "cwd": ".",
      "command": [
        "cargo",
        "test",
        "--locked",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml"
      ]
    },
    "piping-pytest": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests",
        "-n",
        "auto",
        "--dist",
        "loadscope"
      ]
    },
    "macos-release-sweep": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/release/run_evidence_sweep.py",
        "--execute"
      ]
    },
    "agent-host-witness-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_host_witness_test.py"
      ]
    },
    "agent-catalog-resource": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_catalog_resource.py",
        "--check"
      ]
    },
    "agent-supplier-resource-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_supplier_resource_test.py"
      ]
    },
    "agent-supplier-bundle-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_supplier_bundle_test.py"
      ]
    },
    "agent-live-session-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/agent_live_session_fixture_test.py"
      ]
    },
    "agent-journey-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/agent_journey_fixture_test.py",
        "tools/agent_journey_memory_monitor_test.py",
        "tools/agent_supplier_capture_test.py"
      ]
    },
    "model-version-literals": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests/test_model_version_literals.py"
      ]
    },
    "retained-pricing-tool-tests": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/retained_pricing/tests",
        "-n",
        "auto"
      ]
    },
    "benchmark-reference-tests": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "validation/benchmarks/numerical_integrity/test_reference.py",
        "validation/benchmarks/numerical_robustness/runner/test_vk_scale_runner.py"
      ]
    }
  },
  "always_checks": [],
  "path_rules": [
    {
      "paths": [
        "tools/agent_journey_fixture.py",
        "tools/agent_journey_fixture_test.py",
        "tools/agent_journey_memory_monitor.py",
        "tools/agent_journey_memory_monitor_test.py",
        "tools/agent_supplier_capture.py",
        "tools/agent_supplier_capture_test.py",
        "tools/agent_live_session_fixture.py",
        "apps/desktop/native-smoke/agent-journey.js",
        "fixtures/model_operations/agent_w9a_journey.json",
        "fixtures/model_operations/agent_w9a_capture_outcomes.json",
        "validation/references/w9_benchmarks/references.json",
        "software-workflow.json",
        "execution/PKG-16/DEL-16-06/Work/agent-witness-pin.json",
        "apps/desktop/src-tauri/Cargo.toml",
        "apps/desktop/src-tauri/src/embedded_agent/live_runtime.rs",
        "apps/desktop/src-tauri/src/embedded_agent/macos.rs",
        "execution/PKG-16/DEL-16-06/Work/agent-capability-catalog.json",
        "tools/agent_host_witness.py"
      ],
      "checks": [
        "agent-journey-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_live_session_fixture.py",
        "tools/agent_live_session_fixture_test.py",
        "tools/agent_host_process_probe.c",
        "tools/agent_host_sandbox_probe.rs",
        "apps/desktop/src-tauri/src/embedded_agent/session_fixture.rs",
        "apps/desktop/src-tauri/src/embedded_agent/process_scope.rs",
        "software-workflow.json"
      ],
      "checks": [
        "agent-live-session-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_supplier_resource.py",
        "tools/agent_supplier_resource_test.py",
        "apps/desktop/src-tauri/resources/agent-supplier-pins.json",
        "docs/THIRD_PARTY_NOTICES.md",
        "docs/third-party/codex-0.160.0-LICENSE.txt",
        "docs/third-party/codex-0.160.0-NOTICE.txt",
        "tools/agent_supplier_bundle.py",
        "tools/agent_supplier_bundle_test.py",
        "tools/release/build_signed_app.py",
        "tests/test_release_signed_build_script.py",
        "docs/**",
        "software-workflow.json"
      ],
      "checks": [
        "agent-supplier-bundle-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_supplier_resource.py",
        "tools/agent_supplier_resource_test.py",
        "apps/desktop/src-tauri/resources/agent-supplier-pins.json",
        "docs/THIRD_PARTY_NOTICES.md",
        "docs/third-party/codex-0.160.0-LICENSE.txt",
        "docs/third-party/codex-0.160.0-NOTICE.txt",
        "software-workflow.json"
      ],
      "checks": [
        "agent-supplier-resource-offline"
      ]
    },
    {
      "paths": [
        "execution/PKG-16/DEL-16-06/Work/agent-capability-catalog.json",
        "apps/desktop/src-tauri/resources/agent-capability-catalog.json",
        "tools/agent_catalog_resource.py",
        "software-workflow.json"
      ],
      "checks": [
        "agent-catalog-resource"
      ]
    },
    {
      "paths": [
        "tools/agent_host_witness.py",
        "tools/agent_host_witness_test.py",
        "execution/PKG-16/DEL-16-06/Work/agent-capability-catalog.json"
      ],
      "checks": [
        "agent-host-witness-offline"
      ]
    },
    {
      "paths": [
        "apps/desktop/**"
      ],
      "checks": [
        "desktop-test",
        "desktop-build"
      ]
    },
    {
      "paths": [
        "apps/desktop/src-tauri/**"
      ],
      "checks": [
        "desktop-rust-test"
      ]
    },
    {
      "paths": [
        "core/reporting/report_package/tests/common/package_basis.rs",
        "core/reporting/report_package/src/forwarding_graph_scan.rs"
      ],
      "checks": [
        "desktop-rust-test"
      ]
    },
    {
      "paths": [
        "core/**",
        "validation/**",
        "tests/**",
        "fixtures/reference_system/**"
      ],
      "checks": [
        "piping-pytest"
      ]
    },
    {
      "paths": [
        "apps/desktop/src/**",
        "apps/desktop/src-tauri/src/**",
        "core/model_operations/operation_applier/src/**",
        "core/product_physics/src/**",
        "core/reporting/result_export/src/**",
        "tests/verifiers/**",
        "tools/validation/**",
        "tools/fixtures/**",
        "core/handoff/**",
        "core/project_persistence/**",
        "core/product_preview/**",
        "tests/test_model_version_literals.py",
        "software-workflow.json"
      ],
      "checks": [
        "model-version-literals"
      ]
    },
    {
      "paths": [
        "_harness/**",
        "api/**",
        "apps/desktop/**",
        "docs/**",
        "examples/**",
        "execution/**",
        "fixtures/**",
        "schemas/**",
        "tools/**",
        "AGENTS.md",
        "loop/**",
        "requirements-dev.txt",
        "software-workflow.json"
      ],
      "checks": [
        "piping-pytest"
      ]
    },
    {
      "paths": [
        "core/**",
        "execution/**",
        "tools/**",
        "fixtures/product_preview/pressure_source/**",
        "fixtures/results/**",
        "schemas/load_reference_state.schema.json",
        "schemas/physics_source_recovery.schema.json",
        "schemas/retained_precision_mp_v2.schema.json",
        "software-workflow.json"
      ],
      "checks": [
        "retained-pricing-tool-tests"
      ]
    },
    {
      "paths": [
        "core/**",
        "validation/benchmarks/numerical_integrity/**",
        "validation/benchmarks/numerical_robustness/runner/**",
        "tools/ci/python_test_reads.py",
        "software-workflow.json"
      ],
      "checks": [
        "benchmark-reference-tests"
      ]
    }
  ]
}
