{
  "schema": "chirality-software-workflow/v1",
  "project_root": ".",
  "workspace_root": ".",
  "checks": {
    "desktop-build": {
      "cwd": ".",
      "command": [
        "npm",
        "run",
        "build:desktop"
      ]
    },
    "desktop-test": {
      "cwd": ".",
      "command": [
        "npm",
        "run",
        "test:desktop"
      ]
    },
    "desktop-rust-test": {
      "cwd": ".",
      "command": [
        "cargo",
        "test",
        "--locked",
        "--manifest-path",
        "apps/desktop/src-tauri/Cargo.toml"
      ]
    },
    "modal-eigen-test": {
      "cwd": ".",
      "command": [
        "cargo",
        "test",
        "--locked",
        "--manifest-path",
        "core/solver/modal_eigen/Cargo.toml"
      ]
    },
    "piping-pytest": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests",
        "-n",
        "auto",
        "--dist",
        "loadscope"
      ]
    },
    "macos-release-sweep": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/release/run_evidence_sweep.py",
        "--execute"
      ]
    },
    "agent-host-witness-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_host_witness_test.py"
      ]
    },
    "agent-catalog-resource": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_catalog_resource.py"
      ]
    },
    "agent-supplier-resource-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_supplier_resource_test.py"
      ]
    },
    "agent-supplier-bundle-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/agent_supplier_bundle_test.py"
      ]
    },
    "agent-live-session-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/agent_live_session_fixture_test.py"
      ]
    },
    "agent-journey-offline": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/agent_journey_fixture_test.py",
        "tools/agent_journey_memory_monitor_test.py",
        "tools/agent_supplier_capture_test.py"
      ]
    },
    "model-version-literals": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests/test_model_version_literals.py"
      ]
    },
    "retained-pricing-tool-tests": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tools/retained_pricing/tests",
        "-n",
        "auto"
      ]
    },
    "retained-drift-check": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/ci/python_ci.py",
        "--drift-check"
      ]
    },
    "byte-compare-tool-tests": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests/test_byte_compare_tool.py"
      ]
    },
    "after-worker-family-table": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "tests/test_after_worker_family_table.py"
      ]
    },
    "benchmark-reference-tests": {
      "cwd": ".",
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "validation/benchmarks/numerical_integrity/test_reference.py",
        "validation/benchmarks/numerical_robustness/runner/test_vk_scale_runner.py"
      ]
    },
    "desktop-native-smoke-node-tests": {
      "cwd": ".",
      "command": [
        "node",
        "--test",
        "apps/desktop/native-smoke/*.test.mjs",
        "apps/desktop/scripts/worktreeBuildLock.test.mjs"
      ]
    },
    "annular-bend-reference": {
      "cwd": "validation/references/annular_bend_elasticity",
      "command": [
        "python3",
        "-I",
        "-B",
        "generators/annular_reference.py"
      ]
    },
    "repository-checks": {
      "cwd": ".",
      "command": [
        "python3",
        "tools/ci/repository_checks.py",
        "--event",
        "pull_request",
        "--base",
        "origin/main",
        "--head",
        "HEAD"
      ]
    }
  },
  "always_checks": [
    "repository-checks"
  ],
  "path_rules": [
    {
      "paths": [
        "tools/agent_journey_fixture.py",
        "tools/agent_journey_fixture_test.py",
        "tools/agent_journey_memory_monitor.py",
        "tools/agent_journey_memory_monitor_test.py",
        "tools/agent_supplier_capture.py",
        "tools/agent_supplier_capture_test.py",
        "tools/agent_live_session_fixture.py",
        "apps/desktop/native-smoke/agent-journey.js",
        "fixtures/model_operations/agent_w9a_journey.json",
        "fixtures/model_operations/agent_w9a_capture_outcomes.json",
        "validation/references/w9_benchmarks/references.json",
        "software-workflow.json",
        "fixtures/embedded_agent/agent-witness-pin.json",
        "apps/desktop/src-tauri/Cargo.toml",
        "apps/desktop/src-tauri/src/embedded_agent/live_runtime.rs",
        "apps/desktop/src-tauri/src/embedded_agent/macos.rs",
        "apps/desktop/src-tauri/resources/agent-capability-catalog.json",
        "tools/agent_host_witness.py"
      ],
      "checks": [
        "agent-journey-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_live_session_fixture.py",
        "tools/agent_live_session_fixture_test.py",
        "tools/agent_host_process_probe.c",
        "tools/agent_host_sandbox_probe.rs",
        "apps/desktop/src-tauri/src/embedded_agent/session_fixture.rs",
        "apps/desktop/src-tauri/src/embedded_agent/process_scope.rs",
        "software-workflow.json"
      ],
      "checks": [
        "agent-live-session-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_supplier_resource.py",
        "tools/agent_supplier_resource_test.py",
        "apps/desktop/src-tauri/resources/agent-supplier-pins.json",
        "docs/THIRD_PARTY_NOTICES.md",
        "docs/third-party/codex-0.160.0-LICENSE.txt",
        "docs/third-party/codex-0.160.0-NOTICE.txt",
        "tools/agent_supplier_bundle.py",
        "tools/agent_supplier_bundle_test.py",
        "tools/release/build_signed_app.py",
        "tests/test_release_signed_build_script.py",
        "docs/**",
        "software-workflow.json"
      ],
      "checks": [
        "agent-supplier-bundle-offline"
      ]
    },
    {
      "paths": [
        "tools/agent_supplier_resource.py",
        "tools/agent_supplier_resource_test.py",
        "apps/desktop/src-tauri/resources/agent-supplier-pins.json",
        "docs/THIRD_PARTY_NOTICES.md",
        "docs/third-party/codex-0.160.0-LICENSE.txt",
        "docs/third-party/codex-0.160.0-NOTICE.txt",
        "software-workflow.json"
      ],
      "checks": [
        "agent-supplier-resource-offline"
      ]
    },
    {
      "paths": [
        "apps/desktop/src-tauri/resources/agent-capability-catalog.json",
        "tools/agent_catalog_resource.py",
        "tools/agent_host_witness.py",
        "fixtures/embedded_agent/agent-witness-pin.json",
        "software-workflow.json"
      ],
      "checks": [
        "agent-catalog-resource"
      ]
    },
    {
      "paths": [
        "tools/agent_host_witness.py",
        "tools/agent_host_witness_test.py",
        "apps/desktop/src-tauri/resources/agent-capability-catalog.json"
      ],
      "checks": [
        "agent-host-witness-offline"
      ]
    },
    {
      "paths": [
        "apps/desktop/**"
      ],
      "checks": [
        "desktop-test",
        "desktop-build"
      ]
    },
    {
      "paths": [
        "apps/desktop/src-tauri/**"
      ],
      "checks": [
        "desktop-rust-test"
      ]
    },
    {
      "paths": [
        "core/solver/modal_eigen/**",
        "core/solver/sparse_direct/**",
        "core/solver/frame_kernel/**",
        "core/numerics/correct_norm/**"
      ],
      "checks": [
        "modal-eigen-test"
      ]
    },
    {
      "paths": [
        "core/reporting/report_package/tests/common/package_basis.rs",
        "core/reporting/report_package/src/forwarding_graph_scan.rs"
      ],
      "checks": [
        "desktop-rust-test"
      ]
    },
    {
      "paths": [
        "core/**",
        "validation/**",
        "tests/**",
        "fixtures/reference_system/**"
      ],
      "checks": [
        "piping-pytest"
      ]
    },
    {
      "paths": [
        "apps/desktop/src/**",
        "apps/desktop/src-tauri/src/**",
        "core/model_operations/operation_applier/src/**",
        "core/product_physics/src/**",
        "core/reporting/result_export/src/**",
        "tests/verifiers/**",
        "tools/validation/**",
        "tools/fixtures/**",
        "core/handoff/**",
        "core/project_persistence/**",
        "core/product_preview/**",
        "tests/test_model_version_literals.py",
        "software-workflow.json"
      ],
      "checks": [
        "model-version-literals"
      ]
    },
    {
      "paths": [
        "_harness/**",
        "api/**",
        "apps/desktop/**",
        "docs/**",
        "examples/**",
        "fixtures/**",
        "schemas/**",
        "tools/**",
        "AGENTS.md",
        "requirements-dev.txt",
        "software-workflow.json"
      ],
      "checks": [
        "piping-pytest"
      ]
    },
    {
      "paths": [
        "tools/retained_pricing/**",
        "tools/repository_history.py",
        "core/product_physics/src/retained_memory.rs",
        "core/product_physics/build.rs",
        "core/product_physics/src/build_identity.rs",
        "core/product_physics/tests/retained_memory_challenge.rs",
        ".github/workflows/retained-registration-rust.yml",
        "software-workflow.json"
      ],
      "checks": [
        "retained-pricing-tool-tests"
      ]
    },
    {
      "paths": [
        "tools/byte_compare/**",
        "tests/test_byte_compare_tool.py",
        "software-workflow.json"
      ],
      "checks": [
        "byte-compare-tool-tests"
      ]
    },
    {
      "paths": [
        "apps/desktop/src/features/results/NativeResultsPanel.tsx",
        "apps/desktop/src/features/results/ResultsPanel.tsx",
        "apps/desktop/src/features/results/numericalResultQuality.ts",
        "apps/desktop/src/features/results/resultReader.ts",
        "apps/desktop/src/features/results/resultStanding.ts",
        "apps/desktop/src/features/results/resultsNavigator.ts",
        "apps/desktop/src/features/workspace/resultsSessionState.ts",
        "apps/desktop/src/features/workspace/workspaceSession.ts",
        "apps/desktop/src/services/analysisRunPreview.ts",
        "apps/desktop/src/services/hashService.ts",
        "apps/desktop/src/services/inputManifestService.ts",
        "apps/desktop/src/services/jsonText.ts",
        "apps/desktop/src/services/memoryPool.ts",
        "apps/desktop/src/services/modelRulePackResolution.ts",
        "apps/desktop/src/services/nativeIngress.ts",
        "apps/desktop/src/services/nativeResult.ts",
        "apps/desktop/src/services/previewService.ts",
        "apps/desktop/src/services/resultDetail.ts",
        "apps/desktop/src/services/resultSummary.ts",
        "apps/desktop/src/services/solveTimeline.ts",
        "apps/desktop/src/test-support/after-worker/**",
        "tools/after_worker_family/**",
        "tests/test_after_worker_family_table.py",
        "software-workflow.json"
      ],
      "checks": [
        "after-worker-family-table"
      ]
    },
    {
      "paths": [
        "core/**",
        "validation/benchmarks/numerical_integrity/**",
        "validation/benchmarks/numerical_robustness/runner/**",
        "tools/ci/python_test_reads.py",
        "software-workflow.json"
      ],
      "checks": [
        "benchmark-reference-tests"
      ]
    },
    {
      "paths": [
        "apps/desktop/native-smoke/**",
        "apps/desktop/scripts/**",
        "apps/desktop/src-tauri/src/native_smoke.rs",
        "apps/desktop/package.json",
        "package-lock.json",
        "core/solver/performance_harness/observations/rack/**",
        "core/solver/performance_harness/rack/**",
        "docs/PRD.md",
        "software-workflow.json"
      ],
      "checks": [
        "desktop-native-smoke-node-tests"
      ]
    },
    {
      "paths": [
        "validation/references/annular_bend_elasticity/**",
        "validation/caepipe_benchmark/models/cpb-g[234]-*.json",
        "docs/RELEASE_LIMITATIONS_v1.0.md",
        ".github/workflows/annular-bend-reference.yml",
        "software-workflow.json"
      ],
      "checks": [
        "annular-bend-reference"
      ]
    }
  ]
}
