      "const": "0.2.0"
    },
    "deliverable_id": {
      "const": "DEL-17-06"
    },
    "package_id": {
      "const": "PKG-17"
    },
    "scope_items": {
      "const": [
        "SOW-046",
        "SOW-074"
      ]
    },
    "objectives": {
      "const": [
        "OBJ-007",
        "OBJ-017",
        "OBJ-018"
      ]
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "package_status": {
      "const": "stress_neutral_export_package"
    },
    "schema_conformant": {
      "const": true
    },
    "validation_ready": {
      "type": "boolean"
    },
    "source_result_ref": {
      "$ref": "#/$defs/Reference"
    },
    "source_run_ref": {
      "$ref": "#/$defs/Reference"
    },
    "source_model_ref": {
      "$ref": "#/$defs/Reference"
    },
    "received_source_checksums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReceivedChecksum"
      }
    },
    "unresolved_assumption_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "reproducibility_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "export_profile": {
      "allOf": [
