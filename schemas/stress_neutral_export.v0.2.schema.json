    "UnitWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "source_row_index",
        "result_id",
        "source_quantity",
        "target_quantity",
        "conversion_performed",
        "policy"
      ],
      "properties": {
        "witness_id": {
          "type": "string"
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "result_id": {
          "type": "string"
        },
        "source_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "target_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "conversion_performed": {
          "const": false
        },
        "policy": {
          "const": "preserve_received_value_and_unit"
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "dimension"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "check_status",
        "blocking_count",
        "diagnostic_count",
        "provenance"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "check_status": {
          "enum": [
            "passed",
            "blocking"
          ]
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
