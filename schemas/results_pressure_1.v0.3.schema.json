{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpipestress.org/schemas/results_pressure_1.v0.3.schema.json",
  "title": "pressure-1 definitions of the derivative result export 0.3",
  "description": "pressure-1 (3.0.0/exact_pressure_v3: straight pipe, realized arcs and objective connectors): ResultEnvelope's pressure-1 branch, result sets and contract evidence, referenced by results.v0.3.schema.yaml and stress_neutral_export.v0.3.schema.json and kept apart so that readers of the other semantics do not embed them.",
  "$defs": {
    "PressureResultEnvelope": {
      "description": "ResultEnvelope's pressure-1 branch (results.v0.3.schema.yaml ResultEnvelope.oneOf).",
      "required": [
        "contract_evidence"
      ],
      "properties": {
        "producer": {
          "properties": {
            "semantic_contract_id": {
              "const": "openpipestress.result_semantics/0.3.0/pressure-1"
            }
          }
        },
        "semantic_contract_ref": {
          "properties": {
            "ref_id": {
              "const": "openpipestress.result_semantics/0.3.0/pressure-1"
            }
          }
        },
        "formulation_basis": {
          "properties": {
            "profile_id": {
              "const": "exact_pressure_v3"
            }
          }
        },
        "contract_evidence": {
          "$ref": "#/$defs/PressureContractEvidence"
        },
        "result_sets": {
          "items": {
            "$ref": "#/$defs/PressureResultSet"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "source_block_recovery"
            ]
          }
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "retained_precision"
            ]
          }
        },
        {
          "properties": {
            "row_disclosures": {
              "items": {
                "properties": {
                  "reason_code": {
                    "not": {
                      "enum": [
                        "retained_precision_absolute_verified",
                        "retained_precision_not_covered"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "PressureRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "load_case_id",
        "region_id",
        "profile_mode",
        "profile_version",
        "pressure_basis",
        "p_pa",
        "external_pressure_increment_pa",
        "member_pipe_ids",
        "geometry",
        "materials",
        "terminals",
        "applied_loads",
        "approximation",
        "provenance",
        "geometry_representation_guard",
        "result_ids"
      ],
      "properties": {
        "load_case_id": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_mode": {
          "const": "exact_pressure_v3"
        },
        "profile_version": {
          "const": "3.0.0"
        },
        "pressure_basis": {
          "const": "internal_differential_zero_external_v1"
        },
        "p_pa": {
          "type": "number"
        },
        "external_pressure_increment_pa": {
          "const": 0
        },
        "member_pipe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geometry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outside_diameter_m",
              "effective_wall_thickness_m",
              "ri_m",
              "ro_m",
              "Ai_m2",
              "As_m2",
              "I_m4",
              "J_m4",
              "Z_m3",
              "pipe_id",
              "geometry_basis",
              "traversal_forward"
            ],
            "properties": {
              "outside_diameter_m": {
                "type": "number"
              },
              "effective_wall_thickness_m": {
                "type": "number"
              },
              "ri_m": {
                "type": "number"
              },
              "ro_m": {
                "type": "number"
              },
              "Ai_m2": {
                "type": "number"
              },
              "As_m2": {
                "type": "number"
              },
              "I_m4": {
                "type": "number"
              },
              "J_m4": {
                "type": "number"
              },
              "Z_m3": {
                "type": "number"
              },
              "pipe_id": {
                "type": "string",
                "minLength": 1
              },
              "geometry_basis": {
                "const": "authored_normalized_od_wall_v1"
              },
              "traversal_forward": {
                "type": "boolean"
              },
              "member_kind": {
                "const": "realized_arc"
              },
              "arc_end_tangents_global": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "dependentRequired": {
              "member_kind": [
                "arc_end_tangents_global"
              ],
              "arc_end_tangents_global": [
                "member_kind"
              ]
            }
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pipe_id",
              "material_id",
              "E_pa",
              "nu",
              "G_pa",
              "constitutive_basis",
              "thermal_consumed",
              "alpha_per_kelvin",
              "provenance",
              "temperature_basis"
            ],
            "properties": {
              "pipe_id": {
                "type": "string",
                "minLength": 1
              },
              "material_id": {
                "type": "string",
                "minLength": 1
              },
              "E_pa": {
                "type": "number"
              },
              "nu": {
                "type": "number"
              },
              "G_pa": {
                "type": "number"
              },
              "constitutive_basis": {
                "const": "homogeneous_isotropic_E_nu_v1"
              },
              "thermal_consumed": {
                "type": "boolean"
              },
              "alpha_per_kelvin": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "temperature_basis": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "selection"
                        ],
                        "properties": {
                          "selection": {
                            "const": "base_material"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "selection",
                          "point_id"
                        ],
                        "properties": {
                          "selection": {
                            "const": "exact_point"
                          },
                          "point_id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "selection",
                          "temperature_value",
                          "temperature_unit"
                        ],
                        "properties": {
                          "selection": {
                            "const": "interpolation"
                          },
                          "temperature_value": {
                            "type": "number"
                          },
                          "temperature_unit": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    ]
                  },
                  {
                    "const": "resolved_member_state"
                  }
                ]
              }
            }
          }
        },
        "terminals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_ref",
              "closure_transfer",
              "provenance",
              "closure_pressure_load_global_n",
              "pipe_cap_transfer_global_n",
              "remote_closure_excluded_from_pipe_solve",
              "remote_closure_support_reaction_global_n"
            ],
            "properties": {
              "node_ref": {
                "type": "string",
                "minLength": 1
              },
              "closure_transfer": {
                "enum": [
                  "transfers_to_wall",
                  "separately_supported_or_compensated"
                ]
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "closure_pressure_load_global_n": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "pipe_cap_transfer_global_n": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "remote_closure_excluded_from_pipe_solve": {
                "type": "boolean"
              },
              "remote_closure_support_reaction_global_n": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            }
          }
        },
        "applied_loads": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pipe_id",
                  "eigenload_pair_local_n",
                  "local_x_global",
                  "mathematical_cap_pair_local_n",
                  "thermal_included"
                ],
                "properties": {
                  "pipe_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eigenload_pair_local_n": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "local_x_global": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "mathematical_cap_pair_local_n": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "thermal_included": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pipe_id",
                  "bend_term",
                  "arc_pressure_strain",
                  "arc_pressure_strain_definition",
                  "mathematical_cap_pair_local_n",
                  "arc_end_tangents_global",
                  "bend_cap_pair_removed_global_n",
                  "thermal_included"
                ],
                "properties": {
                  "pipe_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bend_term": {
                    "const": "K_b*u_free(eps_p)-c_b"
                  },
                  "arc_pressure_strain": {
                    "type": "number"
                  },
                  "arc_pressure_strain_definition": {
                    "const": "(1-2nu)pAi/(E As)"
                  },
                  "mathematical_cap_pair_local_n": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "arc_end_tangents_global": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "bend_cap_pair_removed_global_n": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "thermal_included": {
                    "const": false
                  }
                }
              }
            ]
          }
        },
        "approximation": {
          "enum": [
            "long_straight_annulus_small_strain_v2",
            "straight_lame_annulus_and_realized_arc_member_term_h2_small_strain_v3"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "geometry_representation_guard": {
          "const": {
            "epsilon_multiplier": 64,
            "meaning": "arithmetic_representation_only"
          }
        },
        "result_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tangency_tolerance_rad": {
          "const": 0.001
        },
        "tangency_rule": {
          "type": "string",
          "minLength": 1
        },
        "bend_adjacent_junctions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_ref",
              "pipe_in",
              "pipe_out",
              "t_in_global",
              "t_out_global",
              "theta_rad"
            ],
            "properties": {
              "node_ref": {
                "type": "string",
                "minLength": 1
              },
              "pipe_in": {
                "type": "string",
                "minLength": 1
              },
              "pipe_out": {
                "type": "string",
                "minLength": 1
              },
              "t_in_global": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "t_out_global": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "theta_rad": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.001
              }
            }
          }
        },
        "withheld_on_arcs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_kinds",
            "reason"
          ],
          "properties": {
            "result_kinds": {
              "const": [
                "pipe_lame_radial_stress_v2",
                "pipe_lame_hoop_stress_v2",
                "pipe_elastic_normal_stress_maximum_v2"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": "pressure-1 (3.0.0/exact_pressure_v3) pressure region. A region with a realized arc carries the arc keys and the arc approximation; its arc members carry member_kind and their end tangents and the bend-term applied-load record. Closed shape only; cross-binding (traversal, junction tangents, withheld rows, RHS terms) is executable reader validation.",
      "oneOf": [
        {
          "properties": {
            "approximation": {
              "const": "long_straight_annulus_small_strain_v2"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "tangency_tolerance_rad"
                ]
              },
              {
                "required": [
                  "tangency_rule"
                ]
              },
              {
                "required": [
                  "bend_adjacent_junctions"
                ]
              },
              {
                "required": [
                  "withheld_on_arcs"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "approximation": {
              "const": "straight_lame_annulus_and_realized_arc_member_term_h2_small_strain_v3"
            }
          },
          "required": [
            "tangency_tolerance_rad",
            "tangency_rule",
            "bend_adjacent_junctions",
            "withheld_on_arcs"
          ]
        }
      ]
    },
    "PressureResolvedPipeMaterial": {
      "description": "pressure-1 0.4.0 resolved per-member material: the same closed shape as load_reference_state.schema.json LoadReferencePipeMaterial, held locally so closed-shape checkers resolve it in this file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipe_id",
        "material_id",
        "E_pa",
        "nu",
        "G_pa",
        "constitutive_basis",
        "thermal_consumed",
        "alpha_per_kelvin",
        "provenance",
        "material_selection_kind",
        "resolved_eigenstrain"
      ],
      "properties": {
        "pipe_id": {
          "type": "string",
          "minLength": 1
        },
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "E_pa": {
          "type": "number"
        },
        "nu": {
          "type": "number"
        },
        "G_pa": {
          "type": "number"
        },
        "constitutive_basis": {
          "const": "homogeneous_isotropic_E_nu_v1"
        },
        "thermal_consumed": {
          "type": "boolean"
        },
        "alpha_per_kelvin": {
          "type": [
            "number",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "material_selection_kind": {
          "enum": [
            "explicit_base_properties",
            "exact_point",
            "temperature_interpolation"
          ]
        },
        "resolved_eigenstrain": {
          "type": "number"
        }
      }
    },
    "PressureExactCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "load_case_id",
        "profile_mode",
        "material_basis",
        "pipe_materials",
        "pipe_sections",
        "pipe_stress_extrema",
        "stress_maximum_coverage",
        "pressure_rhs_assembly"
      ],
      "properties": {
        "load_case_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_mode": {
          "const": "exact_pressure_v3"
        },
        "material_basis": {
          "type": "string",
          "minLength": 1
        },
        "pipe_materials": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "results.v0.3.schema.yaml#/$defs/PhysicsMaterial"
              },
              {
                "$ref": "#/$defs/PressureResolvedPipeMaterial"
              }
            ]
          }
        },
        "pipe_sections": {
          "type": "array",
          "items": {
            "$ref": "results.v0.3.schema.yaml#/$defs/PhysicsGeometry"
          }
        },
        "pipe_stress_extrema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pipe_id",
              "result_id",
              "station_fraction",
              "span_index",
              "local_fraction",
              "value_lower_pa",
              "value_upper_pa",
              "global_upper_bound_pa",
              "certified_gap_pa",
              "subdivisions",
              "approximation",
              "coefficient_basis",
              "enclosure_scope"
            ],
            "properties": {
              "pipe_id": {
                "type": "string",
                "minLength": 1
              },
              "result_id": {
                "type": "string",
                "minLength": 1
              },
              "station_fraction": {
                "type": "number"
              },
              "span_index": {
                "type": "integer",
                "minimum": 0
              },
              "local_fraction": {
                "type": "number"
              },
              "value_lower_pa": {
                "type": "number"
              },
              "value_upper_pa": {
                "type": "number"
              },
              "global_upper_bound_pa": {
                "type": "number"
              },
              "certified_gap_pa": {
                "type": "number"
              },
              "subdivisions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 131072
              },
              "approximation": {
                "const": "piecewise_quadratic_straight_section_statics"
              },
              "coefficient_basis": {
                "const": "j_side_section_equilibrium_binary64"
              },
              "enclosure_scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stress_maximum_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "unavailable_pipe_ids"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "unavailable_pipe_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pressure_rhs_assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "load_case_id",
            "node_order",
            "dof_order",
            "dof_units",
            "assembled_pressure_rhs_global",
            "rounded_cap_rhs_global",
            "rounded_poisson_rhs_global",
            "groups",
            "rounded_cap_and_eigen_ledgers_are_observational",
            "cancellation_screen",
            "screen_limit",
            "screen_roundoff_multiplier",
            "screen_is_not_numerical_qualification"
          ],
          "properties": {
            "method": {
              "const": "source_factor_grouped_pressure_rhs_v1"
            },
            "load_case_id": {
              "type": "string",
              "minLength": 1
            },
            "node_order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dof_order": {
              "const": [
                "Fx",
                "Fy",
                "Fz",
                "Mx",
                "My",
                "Mz"
              ]
            },
            "dof_units": {
              "const": [
                "N",
                "N",
                "N",
                "N*m",
                "N*m",
                "N*m"
              ]
            },
            "assembled_pressure_rhs_global": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "rounded_cap_rhs_global": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "rounded_poisson_rhs_global": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_ref",
                  "component",
                  "pressure_bits",
                  "source_inner_radius_hi_bits",
                  "source_inner_radius_lo_bits",
                  "direction_component_magnitude",
                  "coefficient_sum",
                  "assembled_force_n",
                  "terms"
                ],
                "properties": {
                  "node_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "component": {
                    "enum": [
                      "Fx",
                      "Fy",
                      "Fz"
                    ]
                  },
                  "pressure_bits": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "source_inner_radius_hi_bits": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "source_inner_radius_lo_bits": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "direction_component_magnitude": {
                    "type": "number"
                  },
                  "coefficient_sum": {
                    "type": "number"
                  },
                  "assembled_force_n": {
                    "type": "number"
                  },
                  "terms": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "coefficient",
                        "region_id",
                        "pipe_id",
                        "kind"
                      ],
                      "properties": {
                        "coefficient": {
                          "type": "number"
                        },
                        "region_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pipe_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "bend_cap_removed",
                            "kink_remainder",
                            "poisson_eigen",
                            "terminal_cap"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "rounded_cap_and_eigen_ledgers_are_observational": {
              "const": true
            },
            "cancellation_screen": {
              "type": "number"
            },
            "screen_limit": {
              "const": 1e-09
            },
            "screen_roundoff_multiplier": {
              "const": 32
            },
            "screen_is_not_numerical_qualification": {
              "const": true
            }
          }
        }
      },
      "description": "pressure-1 exact case on 0.3.0 (physics-1's case under exact_pressure_v3) or 0.4.0 (resolved per-member materials). The RHS terms add the bend's removed caps and the junction remainder."
    },
    "PressureConnectorRecord": {
      "type": "object",
      "additionalProperties": false,
