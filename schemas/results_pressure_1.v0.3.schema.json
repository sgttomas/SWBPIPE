          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "end_i_node_axes_global": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "end_j_node_axes_global": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "end_i_offset_local_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "end_j_offset_local_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "q_ref": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        },
        "reference_state": {
          "enum": [
            "stress_free",
            "prestressed"
          ]
        },
        "work_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "representation",
            "coordinate_order",
            "translation_scale_m",
            "rotation_scale_rad",
            "coefficient_unit",
            "upper_triangle",
            "source_reference"
          ],
          "properties": {
            "representation": {
              "const": "scaled_work_coefficients_v1"
            },
            "coordinate_order": {
              "const": [
                "tx",
                "ty",
                "tz",
                "rx",
                "ry",
                "rz"
              ]
            },
            "translation_scale_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotation_scale_rad": {
              "const": 1
            },
            "coefficient_unit": {
              "const": "N*m"
            },
            "upper_triangle": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21,
              "items": {
                "type": "number"
              }
            },
            "source_reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "calibration": {
          "const": "constant_structural_elasticity_v1"
        },
        "hardware": {
          "const": "untied"
        },
        "pressure_model": {
          "const": "unpressurized"
        },
        "temperature_applicability": {
          "const": "fixed_installed_parameters_v1"
        },
        "installed_reference_temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
