      "required": [
        "component_id",
        "topology",
        "replaced_pipe_id",
        "node_i",
        "node_j",
        "motion_basis",
        "connector_axes_global",
        "end_i_node_axes_global",
        "end_j_node_axes_global",
        "end_i_offset_local_m",
