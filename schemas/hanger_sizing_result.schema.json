                "travel_case",
                "variation_case"
              ],
              "additionalProperties": false
            },
            "verification_assumption": {
              "$ref": "#/$defs/SpringAssumption"
            },
            "verification": {
              "$ref": "#/$defs/VariableVerification"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "selected",
                "selected_by_fallback"
              ]
            },
            "selected": {
              "$ref": "#/$defs/ConstantSelection"
            },
            "governing": {
              "type": "object",
              "properties": {
                "travel_case": {
                  "type": "string"
                },
                "variation_case": {
                  "type": "null"
                }
              },
              "required": [
                "travel_case",
                "variation_case"
              ],
              "additionalProperties": false
            },
            "verification_assumption": {
              "$ref": "#/$defs/ForceAssumption"
            },
            "verification": {
              "$ref": "#/$defs/ConstantVerification"
            }
          }
        }
      ]
    },
    "Solve": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^(S_W|S_C|S_O[1-9][0-9]*|V_C|V_O[1-9][0-9]*)$"
        },
        "case": {
          "type": "string"
        },
        "derived_document_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/StateCode"
          },
          "description": "Each nonlinear support's state in this solve; empty when the model has none."
        }
      },
      "required": [
        "label",
        "case",
        "derived_document_sha256",
        "states"
      ],
      "additionalProperties": false
    },
    "Disclosure": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "HANGER_SIZING_SUPPORT_STATE_DIFFERS",
            "HANGER_SIZING_COLD_REFERENCE_STATE_DIFFERS"
          ]
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Sorted bytewise."
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "names",
        "message"
      ],
      "additionalProperties": false
    },
    "Refusal": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/RefusalCode"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "names",
        "message"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "verification_standing": {
          "enum": [
            "unconditional",
            "conditional"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Case"
          },
          "description": "Weight, design operating, then the checks in request order."
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        },
        "solves": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/Solve"
          },
          "description": "Exactly 2n + 3: S_W, S_C, S_O1…S_On, V_C, V_O1…V_On."
        },
        "disclosures": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Disclosure"
          }
        }
      },
      "required": [
        "verification_standing",
        "cases",
        "candidates",
        "solves",
        "disclosures"
      ],
      "additionalProperties": false
    },
    "SizedDocument": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Identity"
        }
      ],
      "properties": {
        "route": {
          "$ref": "#/$defs/Route"
        },
        "status": {
          "const": "sized"
        },
        "inputs": {
          "$ref": "#/$defs/SizedInputs"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "status",
        "inputs",
        "result"
      ],
      "unevaluatedProperties": false
    },
    "RefusedDocument": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Identity"
        }
      ],
      "properties": {
        "status": {
          "const": "refused"
        },
        "inputs": {
          "$ref": "#/$defs/RefusedInputs"
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Refusal"
          },
          "description": "In the engine's order."
        }
      },
      "required": [
        "status",
        "inputs",
        "refusals"
      ],
      "unevaluatedProperties": false
    }
  }
}
