{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpipestress.org/schemas/analysis_run.v0.3.schema.json",
  "title": "Analysis record 0.3 with explicit source semantic contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deliverable_id",
    "package_id",
    "scope_item",
    "objectives",
    "run_contract_status",
    "analysis_run"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "deliverable_id": {
      "const": "DEL-14-02"
    },
    "package_id": {
      "const": "PKG-14"
    },
    "scope_item": {
      "const": "SOW-072"
    },
    "objectives": {
      "type": "array",
      "const": [
        "OBJ-016"
      ]
    },
    "run_contract_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_contract",
        "result_binding",
        "external_validation_boundary"
      ],
      "properties": {
        "record_contract": {
          "const": "strict_analysis_run_v0_3"
        },
        "result_binding": {
          "const": "received_mechanics_result"
        },
        "external_validation_boundary": {
          "const": "reference_only_not_determined_by_software"
        }
      }
    },
    "analysis_run": {
      "$ref": "#/$defs/AnalysisRun"
    }
  },
  "$defs": {
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "ref"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "payload_ref",
        "payload_scope",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "type": "string",
          "enum": [
            "openpipestress_jcs_ijson_v1",
            "rfc8785_jcs"
          ]
        },
        "payload_ref": {
          "$ref": "#/$defs/Reference"
        },
        "payload_scope": {
          "type": "string",
          "enum": [
            "analysis_run_record",
            "received_result",
            "result_row",
            "input_manifest"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "AnalysisRunRecordChecksum": {
      "allOf": [
        {
          "$ref": "#/$defs/Checksum"
        },
        {
          "properties": {
            "canonicalization": {
              "const": "openpipestress_jcs_ijson_v1"
            },
            "payload_scope": {
              "const": "analysis_run_record"
            },
            "payload_ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/Reference"
                },
                {
                  "properties": {
                    "object_type": {
                      "const": "AnalysisRun"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "ReceivedResultChecksum": {
      "allOf": [
        {
          "$ref": "#/$defs/Checksum"
        },
        {
          "properties": {
            "canonicalization": {
              "const": "openpipestress_jcs_ijson_v1"
            },
            "payload_scope": {
              "const": "received_result"
            },
            "payload_ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/Reference"
                },
                {
                  "properties": {
                    "object_type": {
                      "const": "ResultEnvelope"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "ResultRowChecksum": {
      "allOf": [
        {
          "$ref": "#/$defs/Checksum"
        },
        {
          "properties": {
            "canonicalization": {
              "const": "openpipestress_jcs_ijson_v1"
            },
            "payload_scope": {
              "const": "result_row"
            },
            "payload_ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/Reference"
                },
                {
                  "properties": {
                    "object_type": {
                      "const": "Result"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "InputManifestChecksum": {
      "allOf": [
        {
          "$ref": "#/$defs/Checksum"
        },
        {
          "properties": {
            "canonicalization": {
              "const": "rfc8785_jcs"
            },
            "payload_scope": {
              "const": "input_manifest"
            },
            "payload_ref": {
              "allOf": [
                {
                  "$ref": "#/$defs/Reference"
                },
                {
                  "properties": {
                    "object_type": {
                      "const": "InputManifest"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "SemanticContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "openpipestress.result_semantics/0.3.0/pressure-source-1",
            "openpipestress.result_semantics/0.3.0/preview-physics-2",
            "openpipestress.result_semantics/0.3.0/pressure-2",
            "openpipestress.result_semantics/0.3.0/preview-physics-retained-1",
            "openpipestress.result_semantics/0.3.0/physics-retained-1"
          ]
        },
        "sha256": {
          "enum": [
            "5a6630d9157ad1f4232c558d0cd57414677add8d1c95cc0a5d19a2579fb3a05b",
            "be61c6ea828797ad5664d06a2c835b28deffaff07cc33fec6bb4d48a8fcb0919",
            "7d59a8e7fa7b3b997d3809bd90b7efbdda6c91ad46c0fbe31420f11dc4350520",
            "33cc0c4dc1d7dea07e14c16e07f4ee3f93cc2f84e4dd0494e232397d4e3861c1",
            "609a4e92ac19de0f5a1dd067dab64b4abeb7b3b70511e2095455f1d000d28e2c"
          ]
        },
        "signature_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": {
              "const": "openpipestress.result_semantics/0.3.0/preview-physics-2"
            },
            "sha256": {
              "const": "5a6630d9157ad1f4232c558d0cd57414677add8d1c95cc0a5d19a2579fb3a05b"
