    "ResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref",
        "source_row_index",
        "category",
        "source_dimension",
        "result_family",
        "semantic_contract",
        "interpretation",
        "source_annotation",
        "hash_refs",
        "privacy_classification",
        "provenance"
      ],
      "properties": {
        "result_ref": {
          "$ref": "#/$defs/Reference"
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source_dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_contract": {
          "$ref": "#/$defs/SemanticContract"
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "findings"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unit",
            "metadata"
          ],
          "properties": {
            "kind": {},
            "unit": {},
            "metadata": {}
          }
        },
        "hash_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/ResultRowChecksum"
          }
        },
        "privacy_classification": {
          "const": "source_evidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "AnalysisRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_name",
        "run_kind",
        "created_at",
        "model_state_ref",
        "load_basis_refs",
        "diagnostics",
        "result_refs",
        "rule_pack_refs",
        "library_refs",
        "hashes",
        "analysis_status",
        "reproducibility",
        "immutability_policy",
        "professional_boundary",
        "solver_version",
        "settings_ref",
        "unit_system_ref",
        "provenance"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_name": {
          "type": "string",
          "minLength": 1
        },
        "run_kind": {
          "const": "mechanics_solve"
