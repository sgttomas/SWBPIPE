              "const": "be61c6ea828797ad5664d06a2c835b28deffaff07cc33fec6bb4d48a8fcb0919"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "openpipestress.result_semantics/0.3.0/preview-physics-retained-1"
            },
            "sha256": {
              "const": "7d59a8e7fa7b3b997d3809bd90b7efbdda6c91ad46c0fbe31420f11dc4350520"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": "openpipestress.result_semantics/0.3.0/physics-retained-1"
            },
            "sha256": {
              "const": "33cc0c4dc1d7dea07e14c16e07f4ee3f93cc2f84e4dd0494e232397d4e3861c1"
            }
          }
