    "ResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref",
        "source_row_index",
        "category",
        "source_dimension",
        "result_family",
        "semantic_contract",
        "interpretation",
        "source_annotation",
        "hash_refs",
        "privacy_classification",
        "provenance"
      ],
      "properties": {
        "result_ref": {
          "$ref": "#/$defs/Reference"
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source_dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_contract": {
          "$ref": "#/$defs/SemanticContract"
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "findings"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unit",
            "metadata"
          ],
          "properties": {
            "kind": {},
            "unit": {},
            "metadata": {}
          }
        },
        "hash_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/ResultRowChecksum"
          }
        },
        "privacy_classification": {
          "const": "source_evidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "AnalysisRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_name",
        "run_kind",
        "created_at",
        "model_state_ref",
        "load_basis_refs",
        "diagnostics",
        "result_refs",
        "rule_pack_refs",
        "library_refs",
        "hashes",
        "analysis_status",
        "reproducibility",
        "immutability_policy",
        "professional_boundary",
        "solver_version",
        "settings_ref",
        "unit_system_ref",
        "provenance"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_name": {
          "type": "string",
          "minLength": 1
        },
        "run_kind": {
          "const": "mechanics_solve"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_state_ref": {
          "$ref": "#/$defs/Reference"
        },
        "load_basis_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultRef"
          }
        },
        "rule_pack_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "library_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "hashes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/AnalysisRunRecordChecksum"
              },
              {
                "$ref": "#/$defs/ReceivedResultChecksum"
              }
            ]
          },
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/AnalysisRunRecordChecksum"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/ReceivedResultChecksum"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "analysis_status": {
          "type": "array",
          "contains": {
            "const": "HUMAN_REVIEW_REQUIRED"
          },
          "items": {
            "enum": [
              "MODEL_INCOMPLETE",
              "MECHANICS_SOLVED",
              "RULE_INPUTS_INCOMPLETE",
              "USER_RULE_CHECKED",
              "USER_RULE_FAILED",
              "HUMAN_REVIEW_REQUIRED"
            ]
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_manifest_refs",
            "input_manifest_hashes",
            "semantic_contract"
          ],
          "properties": {
            "input_manifest_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/Reference"
              }
            },
            "input_manifest_hashes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/InputManifestChecksum"
              }
            },
            "semantic_contract": {
              "$ref": "#/$defs/SemanticContract"
            },
            "determinism_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unresolved_tbd": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "immutability_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_record_is_read_only",
            "mutation_policy",
            "new_mechanics_run_required_for_record_revision",
            "record_revision_identity",
            "hash_invalidates_external_acceptance"
          ],
          "properties": {
            "run_record_is_read_only": {
              "const": true
            },
            "mutation_policy": {
              "const": "changes_create_new_immutable_record_revision"
            },
            "new_mechanics_run_required_for_record_revision": {
              "const": false
            },
            "record_revision_identity": {
              "const": "analysis_run_record_sha256"
            },
            "hash_invalidates_external_acceptance": {
              "const": true
            }
          }
        },
        "professional_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_review_required",
            "software_makes_compliance_claim",
            "software_makes_certification_claim",
            "software_makes_sealing_claim",
            "software_makes_approval_claim",
            "software_makes_authentication_claim"
          ],
          "properties": {
            "human_review_required": {
              "const": true
            },
            "software_makes_compliance_claim": {
              "const": false
            },
            "software_makes_certification_claim": {
              "const": false
            },
            "software_makes_sealing_claim": {
              "const": false
            },
            "software_makes_approval_claim": {
              "const": false
            },
            "software_makes_authentication_claim": {
              "const": false
            }
          }
        },
        "solver_version": {
          "$ref": "#/$defs/SolverVersion"
        },
        "settings_ref": {
          "$ref": "#/$defs/Reference"
        },
        "unit_system_ref": {
          "$ref": "#/$defs/Reference"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_block_recovery": {
          "oneOf": [
            {
              "$ref": "source_block_recovery.schema.json"
            },
            {
              "$ref": "physics_source_recovery.schema.json"
            },
            {
              "$ref": "results.v0.3.schema.yaml#/$defs/LoadReferenceSourceRecovery"
            },
            {
              "$ref": "physics_source_recovery.schema.json#/$defs/pressure_source_receipt"
            }
          ]
        },
        "contract_evidence": {
          "anyOf": [
            {
              "$ref": "physics_source_recovery.schema.json#/$defs/physical_evidence"
            },
            {
              "$ref": "results.v0.3.schema.yaml#/$defs/LoadReferenceSourceContractEvidence"
            },
            {
              "$ref": "physics_source_recovery.schema.json#/$defs/pressure_source_physical_evidence"
            }
          ]
        },
        "retained_precision": {
          "$ref": "retained_precision_mp_v2.schema.json"
        }
      },
      "oneOf": [
        {
          "properties": {
            "reproducibility": {
              "properties": {
                "semantic_contract": {
                  "properties": {
                    "id": {
                      "const": "openpipestress.result_semantics/0.3.0/precision-1"
                    },
                    "sha256": {
                      "const": "0649e4e4e627e105a3d96a14187c359078d987225d3eec936846986a5ad75f3a"
                    }
                  }
                }
              }
            },
            "result_refs": {
              "items": {
                "properties": {
                  "semantic_contract": {
                    "properties": {
                      "id": {
                        "const": "openpipestress.result_semantics/0.3.0/precision-1"
                      },
                      "sha256": {
                        "const": "0649e4e4e627e105a3d96a14187c359078d987225d3eec936846986a5ad75f3a"
                      }
                    }
                  }
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "source_block_recovery"
