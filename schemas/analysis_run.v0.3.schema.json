    "ResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref",
        "source_row_index",
        "category",
        "source_dimension",
        "result_family",
        "semantic_contract",
        "interpretation",
        "source_annotation",
        "hash_refs",
        "privacy_classification",
        "provenance"
      ],
      "properties": {
        "result_ref": {
          "$ref": "#/$defs/Reference"
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source_dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_contract": {
          "$ref": "#/$defs/SemanticContract"
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "findings"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "unit",
            "metadata"
          ],
          "properties": {
            "kind": {},
            "unit": {},
            "metadata": {}
          }
        },
        "hash_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/ResultRowChecksum"
          }
        },
        "privacy_classification": {
          "const": "source_evidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "AnalysisRun": {
      "type": "object",
