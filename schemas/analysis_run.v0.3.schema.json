            "mutation_policy",
            "new_mechanics_run_required_for_record_revision",
            "record_revision_identity",
            "hash_invalidates_external_acceptance"
          ],
          "properties": {
            "run_record_is_read_only": {
              "const": true
            },
            "mutation_policy": {
              "const": "changes_create_new_immutable_record_revision"
            },
            "new_mechanics_run_required_for_record_revision": {
              "const": false
            },
            "record_revision_identity": {
              "const": "analysis_run_record_sha256"
            },
            "hash_invalidates_external_acceptance": {
              "const": true
            }
          }
        },
        "professional_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_review_required",
            "software_makes_compliance_claim",
            "software_makes_certification_claim",
            "software_makes_sealing_claim",
            "software_makes_approval_claim",
            "software_makes_authentication_claim"
          ],
          "properties": {
            "human_review_required": {
