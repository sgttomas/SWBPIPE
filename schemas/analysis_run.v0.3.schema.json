        "run_kind",
        "created_at",
        "model_state_ref",
        "load_basis_refs",
        "diagnostics",
        "result_refs",
        "rule_pack_refs",
        "library_refs",
        "hashes",
        "analysis_status",
        "reproducibility",
        "immutability_policy",
        "professional_boundary",
        "solver_version",
        "settings_ref",
        "unit_system_ref",
        "provenance"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_name": {
          "type": "string",
          "minLength": 1
        },
        "run_kind": {
          "const": "mechanics_solve"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_state_ref": {
          "$ref": "#/$defs/Reference"
        },
        "load_basis_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        },
        "result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultRef"
          }
        },
        "rule_pack_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "library_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "hashes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/AnalysisRunRecordChecksum"
              },
              {
                "$ref": "#/$defs/ReceivedResultChecksum"
              }
            ]
          },
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/AnalysisRunRecordChecksum"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/ReceivedResultChecksum"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "analysis_status": {
          "type": "array",
          "contains": {
            "const": "HUMAN_REVIEW_REQUIRED"
          },
          "items": {
            "enum": [
              "MODEL_INCOMPLETE",
              "MECHANICS_SOLVED",
              "RULE_INPUTS_INCOMPLETE",
              "USER_RULE_CHECKED",
              "USER_RULE_FAILED",
              "HUMAN_REVIEW_REQUIRED"
            ]
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_manifest_refs",
            "input_manifest_hashes",
            "semantic_contract"
