{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpipestress.org/schemas/analysis_run.legacy-desktop.v0.1.schema.json",
  "title": "Strict abbreviated desktop analysis record 0.1 compatibility schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliverable_id", "package_id", "scope_item", "objectives", "run_contract_status", "analysis_run"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "deliverable_id": {"const": "DEL-14-02"}, "package_id": {"const": "PKG-14"}, "scope_item": {"const": "SOW-072"},
    "objectives": {"const": ["OBJ-016"]},
    "run_contract_status": {"$ref": "#/$defs/RunContractStatus"},
    "analysis_run": {"$ref": "#/$defs/AnalysisRun"}
  },
  "$defs": {
    "Ref": {"type": "object", "additionalProperties": false, "required": ["object_type", "ref"], "properties": {"object_type": {"type": "string", "minLength": 1}, "ref": {"type": "string", "minLength": 1}}},
    "Hash": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "payload_ref", "payload_scope", "value"], "properties": {"algorithm": {"const": "sha256"}, "canonicalization": {"const": "rfc8785_jcs"}, "payload_ref": {"$ref": "#/$defs/Ref"}, "payload_scope": {"enum": ["analysis_run_record", "result_envelope", "result_value", "input_manifest"]}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "RunContractStatus": {"type": "object", "additionalProperties": false, "required": ["record_contract", "model_state_binding", "result_binding", "physical_project_container", "external_validation_boundary"], "properties": {"record_contract": {"const": "schema_first_analysis_run_records"}, "model_state_binding": {"const": "schemas/model_state.schema.json"}, "result_binding": {"const": "schemas/results.schema.yaml"}, "physical_project_container": {"const": "TBD"}, "external_validation_boundary": {"const": "reference_only_not_determined_by_software"}}},
    "ResultRef": {"type": "object", "additionalProperties": false, "required": ["result_ref", "result_family", "source_dimension", "hash_refs", "privacy_classification"], "properties": {"result_ref": {"$ref": "#/$defs/Ref"}, "result_family": {"type": "string", "minLength": 1}, "source_dimension": {"enum": ["dimensionless", "length", "angle", "force", "moment", "stress", "area", "section_modulus", "second_moment_area", "ratio", "time", "temperature", "pressure", "linear_stiffness", "rotational_stiffness"]}, "hash_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/Hash"}, {"properties": {"payload_scope": {"const": "result_value"}}}]}}, "privacy_classification": {"const": "invented_public_example"}}},
    "Reproducibility": {"type": "object", "additionalProperties": false, "required": ["input_manifest_refs", "input_manifest_hashes", "determinism_notes", "unresolved_tbd"], "properties": {"input_manifest_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/Ref"}}, "input_manifest_hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/Hash"}, {"properties": {"payload_scope": {"const": "input_manifest"}}}]}}, "determinism_notes": {"type": "array", "items": {"type": "string"}}, "unresolved_tbd": {"type": "array", "items": {"type": "string"}}}},
    "Immutability": {"type": "object", "additionalProperties": false, "required": ["run_record_is_read_only", "mutation_policy", "new_run_required_for_change", "hash_invalidates_external_acceptance"], "properties": {"run_record_is_read_only": {"const": true}, "mutation_policy": {"const": "changes_create_new_analysis_run"}, "new_run_required_for_change": {"const": true}, "hash_invalidates_external_acceptance": {"const": true}}},
    "Boundary": {"type": "object", "additionalProperties": false, "required": ["human_review_required", "software_makes_compliance_claim", "software_makes_certification_claim", "software_makes_sealing_claim", "software_makes_approval_claim", "software_makes_authentication_claim"], "properties": {"human_review_required": {"const": true}, "software_makes_compliance_claim": {"const": false}, "software_makes_certification_claim": {"const": false}, "software_makes_sealing_claim": {"const": false}, "software_makes_approval_claim": {"const": false}, "software_makes_authentication_claim": {"const": false}}},
    "AnalysisRun": {"type": "object", "additionalProperties": false, "required": ["run_id", "run_name", "run_kind", "model_state_ref", "load_basis_refs", "result_refs", "hashes", "analysis_status", "reproducibility", "immutability_policy", "professional_boundary"], "properties": {
      "run_id": {"type": "string", "minLength": 1}, "run_name": {"type": "string", "minLength": 1}, "run_kind": {"const": "mechanics_solve"}, "model_state_ref": {"$ref": "#/$defs/Ref"}, "load_basis_refs": {"type": "array", "items": {"$ref": "#/$defs/Ref"}}, "result_refs": {"type": "array", "items": {"$ref": "#/$defs/ResultRef"}},
      "hashes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/Hash"}, "allOf": [{"contains": {"properties": {"payload_scope": {"const": "analysis_run_record"}}, "required": ["payload_scope"]}}, {"contains": {"properties": {"payload_scope": {"const": "result_envelope"}}, "required": ["payload_scope"]}}]},
      "analysis_status": {"type": "array", "minItems": 2, "uniqueItems": true, "contains": {"const": "HUMAN_REVIEW_REQUIRED"}, "items": {"enum": ["MODEL_INCOMPLETE", "MECHANICS_SOLVED", "RULE_INPUTS_INCOMPLETE", "USER_RULE_CHECKED", "USER_RULE_FAILED", "HUMAN_REVIEW_REQUIRED"]}}, "reproducibility": {"$ref": "#/$defs/Reproducibility"}, "immutability_policy": {"$ref": "#/$defs/Immutability"}, "professional_boundary": {"$ref": "#/$defs/Boundary"}
    }}
  }
}
