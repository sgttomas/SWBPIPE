+//! (bit for bit on a document without a realized arc); a realized arc that takes its shear
+//! area and so moves the result; and no arc disclosure. The documents are the frozen
+//! `validation/references/pf_timoshenko` requests used as templates and changed in memory;
+//! no expected value here is a reference row (the independent oracle judges the arc's
+//! values, `curved-bend-transverse-shear.md` §8).
+use open_pipe_stress_product_physics::{run_linear_static_preview_value_with_mode, PreviewSolverMode};
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+
+#[path = "common/current_model.rs"]
+mod current_model;
+
+const MODES: [PreviewSolverMode; 2] = [PreviewSolverMode::SparseInteractive, PreviewSolverMode::DenseScrutiny];
+const CANTILEVER: &str = include_str!("../../../validation/references/pf_timoshenko/requests/PFT-SB-L1-CM0-TIMOSHENKO.request.json");
+const ARC_TIP: &str = include_str!("../../../validation/references/pf_timoshenko/requests/PFT-ARC-TIP-TIMOSHENKO.request.json");
+const TABLE: &str = include_str!("../../../fixtures/results/semantic_contract_v0_3_preview_physics_curved_shear_1.json");
+
+const CURVED_ID: &str = "openpipestress.result_semantics/0.3.0/preview-physics-curved-shear-1";
+const CURVED_PROFILE: &str = "product_preview_mechanics_curved_shear_v1";
+const TIMOSHENKO_ID: &str = "openpipestress.result_semantics/0.3.0/preview-physics-timoshenko-1";
+const V2: &str = "timoshenko_annulus_energy_curved_v2";
+const ARCS: &str = "PF_TIMOSHENKO_REALIZED_ARCS_EULER_BERNOULLI";
+
+type Key = (String, String, String, String, String);
+
+fn template(text: &str) -> Value {
+    let mut request: Value = serde_json::from_str(text).unwrap();
+    current_model::reauthor_model(&mut request["model"]);
+    request
+}
+
+fn curved(request: &Value) -> Value {
+    let mut request = request.clone();
+    request["model"]["model_settings"] = json!({"shear_model": V2});
+    request
+}
+
+fn solve(request: &Value, mode: PreviewSolverMode) -> Value {
+    serde_json::to_value(run_linear_static_preview_value_with_mode(request.clone(), mode).expect("admitted at the wire")).unwrap()
+}
+
+fn solved(envelope: &Value, context: &str) {
+    assert_eq!(envelope["status"]["mechanics"], json!("MECHANICS_SOLVED"), "{context}: {}", envelope["diagnostics"]);
+}
+
+fn with_code<'a>(envelope: &'a Value, code: &str) -> Vec<&'a Value> {
+    envelope["diagnostics"].as_array().unwrap().iter().filter(|d| d["code"] == json!(code)).collect()
+}
+
+/// Every published physical row's value by (kind, entity_ref, component, location, load case).
+fn values(envelope: &Value) -> BTreeMap<Key, f64> {
+    let text = |value: &Value| value.as_str().unwrap_or("").to_owned();
+    envelope["results"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|r| r["kind"] != json!("modulus_basis_record"))
+        .map(|r| {
+            let key = (text(&r["kind"]), text(&r["entity_ref"]), text(&r["metadata"]["component"]), text(&r["metadata"]["location"]), text(&r["basis_ref"]["ref_id"]));
+            (key, r["value"].as_f64().unwrap())
+        })
+        .collect()
+}
+
+/// The identity, profile and limitation 0 are the curved-shear table's, and the other
+/// limitations are the route's (the table's own array).
+#[test]
+fn a_curved_result_states_its_own_identity_profile_and_limitations() {
+    let table: Value = serde_json::from_str(TABLE).unwrap();
+    for mode in MODES {
+        let envelope = solve(&curved(&template(ARC_TIP)), mode);
+        solved(&envelope, "arc");
+        assert_eq!(envelope["producer"]["semantic_contract_id"], json!(CURVED_ID));
+        assert_eq!(envelope["formulation_basis"]["profile_id"], json!(CURVED_PROFILE));
+        assert_eq!(envelope["formulation_basis"]["limitations"], table["supported_profile_limitations"], "{mode:?}");
+    }
+}
+
+/// Decision (d): a document without a realized arc is recorded under the curved-shear
+/// identity, and every row is v1's bit for bit.
+#[test]
+fn without_a_realized_arc_every_row_is_v1s_bit_for_bit() {
+    let v1 = template(CANTILEVER);
+    for mode in MODES {
+        let left = solve(&v1, mode);
+        let right = solve(&curved(&v1), mode);
+        solved(&left, "v1");
+        solved(&right, "v2");
+        assert_eq!(left["producer"]["semantic_contract_id"], json!(TIMOSHENKO_ID));
+        assert_eq!(right["producer"]["semantic_contract_id"], json!(CURVED_ID));
+        let (left, right) = (values(&left), values(&right));
+        assert!(!left.is_empty());
+        let differing: Vec<_> = left.keys().chain(right.keys())
+            .filter(|key| left.get(*key).map(|v| v.to_bits()) != right.get(*key).map(|v| v.to_bits()))
+            .collect();
+        assert!(differing.is_empty(), "{mode:?}: {differing:?}");
+    }
+}
+
+/// A realized arc takes its shear area: the result moves from v1's, and no arc is
+/// disclosed as Euler–Bernoulli.
+#[test]
+fn a_realized_arc_carries_shear_and_is_not_disclosed() {
+    let arc = template(ARC_TIP);
+    for mode in MODES {
+        let v1 = solve(&arc, mode);
+        let v2 = solve(&curved(&arc), mode);
+        solved(&v1, "v1 arc");
+        solved(&v2, "v2 arc");
+        assert_eq!(with_code(&v1, ARCS).len(), 1, "{mode:?}: v1 keeps its disclosure");
+        assert!(with_code(&v2, ARCS).is_empty(), "{mode:?}: {}", v2["diagnostics"]);
+        let (left, right) = (values(&v1), values(&v2));
+        assert_eq!(left.keys().collect::<Vec<_>>(), right.keys().collect::<Vec<_>>(), "{mode:?}: the same rows");
+        assert!(left.iter().any(|(key, value)| value.to_bits() != right[key].to_bits()), "{mode:?}: the arc's shear moves the result");
+    }
+}
