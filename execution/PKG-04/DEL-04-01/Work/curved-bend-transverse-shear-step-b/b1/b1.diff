diff --git a/tests/test_preview_curved_shear_identity.py b/tests/test_preview_curved_shear_identity.py
new file mode 100644
--- /dev/null
+++ b/tests/test_preview_curved_shear_identity.py
@@ -0,0 +1,131 @@
+"""DEL-04-01 Design curved-bend-transverse-shear.md §5 (B1): the pressure-free curved-shear identity beside
+preview-physics-2 and the Timoshenko identity.
+
+The Python mirrors of the readers (`tests/verifiers`) and the product's Rust-routed reading
+(`core/analysis_runs/compatibility.py`, the AnalysisRun builder and the stress-neutral package):
+
+- the derived table and its pins agree in every language's constants and in the carrier schemas;
+- model-free, the complete identity (identity, profile and limitation array together) is admitted, and a mix with
+  either other preview identity is refused;
+- model-bound, `timoshenko_annulus_energy_curved_v2` binds this identity and no other, and this identity binds no
+  other selection.
+
+The curved sources here are TRANSFORMED STAND-INS: committed Euler-Bernoulli producer envelopes with the identity,
+the profile and limitation 0 swapped (`curved_of`). Their rows are Euler-Bernoulli values; these tests read identity,
+not mechanics (`core/product_physics/tests/pf_curved_shear_runtime.rs` reads the product's own envelopes).
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from tests.verifiers import compatibility as vc
+from tests.verifiers import preview_physics_evidence as ppe
+from tests.verifiers import reader_verdict as rv
+
+PROJECT = Path(__file__).resolve().parents[1]
+RESULTS = PROJECT / "fixtures/results"
+CURVED_ID = "openpipestress.result_semantics/0.3.0/preview-physics-curved-shear-1"
+CURVED_PROFILE = "product_preview_mechanics_curved_shear_v1"
+CURVED_SHA256 = "14f6b73c8ffcdd44aa461b1f61dab73e5d2c05ebe1229cf38149dde6fad82ccc"
+CURVED_TABLE = RESULTS / "semantic_contract_v0_3_preview_physics_curved_shear_1.json"
+TIMOSHENKO_ID = "openpipestress.result_semantics/0.3.0/preview-physics-timoshenko-1"
+V2 = "timoshenko_annulus_energy_curved_v2"
+SOURCES = {
+    "connected_sparse": "fixtures/model_operations/precision_connected_ui_model.json",
+    "invented_dense": "fixtures/product_preview/invented_demo_model.json",
+}
+
+
+def _json(path: Path):
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def eb(name: str) -> dict:
+    return _json(RESULTS / f"preview_physics_{name}.json")
+
+
+def curved_of(source: dict) -> dict:
+    """A transformed stand-in: the Euler-Bernoulli envelope under the curved-shear identity."""
+    out = deepcopy(source)
+    out["producer"]["semantic_contract_id"] = CURVED_ID
+    out["formulation_basis"] = {"profile_id": CURVED_PROFILE, "limitations": list(ppe.CURVED_SHEAR_LIMITATIONS)}
+    return out
+
+
+def model(name: str, shear_model: str | None = None) -> dict:
+    out = _json(PROJECT / SOURCES[name])
+    if shear_model is not None:
+        out["model_settings"] = {"shear_model": shear_model}
+    return out
+
+
+def test_table_and_pins():
+    assert hashlib.sha256(CURVED_TABLE.read_bytes()).hexdigest() == CURVED_SHA256
+    table = _json(CURVED_TABLE)
+    assert (table["semantic_contract_id"], table["formulation_profile_id"]) == (CURVED_ID, CURVED_PROFILE)
+    assert vc.PREVIEW_PHYSICS_CONTRACTS[CURVED_ID] == (CURVED_SHA256, CURVED_TABLE, CURVED_PROFILE)
+    assert ppe.CURVED_SHEAR_LIMITATIONS == table["supported_profile_limitations"]
+    assert ppe.CURVED_SHEAR_LIMITATIONS[1:] == ppe.LIMITATIONS[1:]
+    assert len({ppe.CURVED_SHEAR_LIMITATIONS[0], ppe.TIMOSHENKO_LIMITATIONS[0], ppe.LIMITATIONS[0]}) == 3
+    assert CURVED_ID in vc.FRESH_CONTRACT_IDS
+    from core.analysis_runs import compatibility as product
+    assert CURVED_ID in product.FRESH_CONTRACT_IDS and CURVED_ID in product.CURRENT_RECORD_CONTRACT_IDS
+    assert product._TABLES[CURVED_ID][0] == CURVED_SHA256
+    from core.handoff.stress_neutral import package
+    assert CURVED_ID in package.SUPPORTED_METHODS
+    assert package._method_namespaces(CURVED_ID) == {"contract_evidence"}
+
+
+def test_carrier_schemas_admit_the_identity_and_hash():
+    analysis = _json(PROJECT / "schemas/analysis_run.v0.3.schema.json")
+    pairs = [(b["properties"]["id"]["const"], b["properties"]["sha256"]["const"]) for b in analysis["$defs"]["SemanticContract"]["oneOf"]]
+    assert (CURVED_ID, CURVED_SHA256) in pairs
+    neutral = _json(PROJECT / "schemas/stress_neutral_export.v0.3.schema.json")
+    consts = [b["properties"]["semantic_contract"]["properties"] for b in neutral["oneOf"] if "semantic_contract" in b.get("properties", {})]
+    assert {"id": {"const": CURVED_ID}, "sha256": {"const": CURVED_SHA256}} in consts
+
+
+@pytest.mark.parametrize("name", list(SOURCES))
+def test_verifier_model_free_readers_admit_the_complete_identity(name):
+    source = curved_of(eb(name))
+    ppe.validate_preview_physics_evidence(source)
+    ppe.validate_transport_metadata(source)
+    assert vc._source_contract(source)[:2] == (CURVED_ID, CURVED_SHA256)
+    assert rv.validate("preview-physics", source) == {"ok": True}
+    assert rv.transport("preview-physics", source) == {"ok": True}
+    dispatch = rv.dispatch(source)
+    assert (dispatch["route"], dispatch["binding"]) == ("preview_physics", {"id": CURVED_ID, "sha256": CURVED_SHA256})
+
+
+def test_verifier_refuses_a_mix_with_another_preview_identity():
+    base = eb("connected_sparse")
+    curved = curved_of(base)
+    mixed = []
+    m = deepcopy(curved); m["formulation_basis"]["limitations"] = list(ppe.TIMOSHENKO_LIMITATIONS); mixed.append(m)
+    m = deepcopy(curved); m["formulation_basis"]["limitations"][0] = ppe.LIMITATIONS[0]; mixed.append(m)
+    m = deepcopy(curved); m["producer"]["semantic_contract_id"] = TIMOSHENKO_ID; mixed.append(m)
+    m = deepcopy(base); m["formulation_basis"] = deepcopy(curved["formulation_basis"]); mixed.append(m)
+    for source in mixed:
+        with pytest.raises(ValueError, match="formulation profile or limitations"):
+            ppe.validate_preview_physics_evidence(source)
+        assert rv.validate("preview-physics", source)["ok"] is False
+
+
+@pytest.mark.parametrize("name", list(SOURCES))
+def test_verifier_model_bound_reader_binds_v2_to_this_identity_only(name):
+    base, curved = eb(name), curved_of(eb(name))
+    timoshenko = deepcopy(base)
+    timoshenko["producer"]["semantic_contract_id"] = TIMOSHENKO_ID
+    timoshenko["formulation_basis"] = {"profile_id": "product_preview_mechanics_timoshenko_v1", "limitations": list(ppe.TIMOSHENKO_LIMITATIONS)}
+    selected = model(name, V2)
+    assert rv.validate("preview-physics", curved, selected) == {"ok": True}
+    assert rv.standing(curved, selected)["findings"] == []
+    for source, bound in ((curved, model(name)), (curved, model(name, "euler_bernoulli")),
+                          (curved, model(name, "timoshenko_annulus_energy_v1")), (base, selected), (timoshenko, selected)):
+        outcome = rv.validate("preview-physics", source, bound)
+        assert outcome["error"]["code"] == rv.SHEAR_MODEL_IDENTITY, outcome
