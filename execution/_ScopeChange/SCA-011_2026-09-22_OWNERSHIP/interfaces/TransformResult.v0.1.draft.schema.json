{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:piping:sca011:draft:TransformResult:0.1.0",
  "title": "TransformResult review-only candidate",
  "description": "UNACCEPTED WIRE DRAFT. Scope allocation does not adopt this serialization, transport, persistence, or compatibility policy. JSON validation is structural only.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "record_kind": {
      "const": "TransformResult"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_type",
          "ref"
        ],
        "properties": {
          "object_type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_type",
          "ref"
        ],
        "properties": {
          "object_type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "professional_boundary": {
      "type": "object",
      "required": [
        "human_review_required",
        "software_makes_compliance_claim",
        "software_makes_certification_claim",
        "software_makes_sealing_claim",
        "software_makes_approval_claim",
        "software_makes_authentication_claim"
      ],
      "properties": {
        "human_review_required": {
          "const": true
        },
        "software_makes_compliance_claim": {
          "const": false
        },
        "software_makes_certification_claim": {
          "const": false
        },
        "software_makes_sealing_claim": {
          "const": false
        },
        "software_makes_approval_claim": {
          "const": false
        },
        "software_makes_authentication_claim": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "analytical_model": {
          "type": "object",
          "required": [
            "model_role"
          ],
          "properties": {
            "model_role": {
              "const": "analytical_solver_model"
            }
          },
          "additionalProperties": true
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "class",
              "severity",
              "message",
              "remediation"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "blocking"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "remediation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "traceability_links": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "has_blocking_findings": {
          "type": "boolean"
        }
      },
      "required": [
        "analytical_model",
        "diagnostics",
        "traceability_links",
        "has_blocking_findings"
      ],
      "additionalProperties": false
    },
    "contract_owner": {
      "const": "DEL-13-04"
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "contract_owner",
    "source_refs",
    "provenance_refs",
    "professional_boundary",
    "payload"
  ],
  "additionalProperties": false
}
