+            .unwrap(),
+        ];
+        let mut input = two_node_axial_problem(
+            supports,
+            vec![
+                SupportStateRecord::new("root", root),
+                SupportStateRecord::new("tip", tip),
+            ],
+            cap,
+        );
+        input.base_restrained_dofs.retain(|dof| *dof != 0);
+        if reverse {
+            input.force[6] = -10.0;
+        }
+        input
+    }
