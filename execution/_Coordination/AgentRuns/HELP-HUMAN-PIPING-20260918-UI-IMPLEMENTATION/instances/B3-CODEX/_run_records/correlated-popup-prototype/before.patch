+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("macos") {
+        let out = std::path::PathBuf::from(std::env::var("OUT_DIR").unwrap());
+        let obj = out.join("public_menu_probe.o");
+        assert!(std::process::Command::new("clang").args(["-fobjc-arc", "-fblocks", "-c", "public_menu_probe.m", "-o"]).arg(&obj).status().unwrap().success());
+        assert!(std::process::Command::new("ar").arg("rcs").arg(out.join("libpublic_menu_probe.a")).arg(&obj).status().unwrap().success());
+        println!("cargo:rustc-link-search=native={}", out.display());
+        println!("cargo:rustc-link-lib=static=public_menu_probe");
+        println!("cargo:rustc-link-lib=framework=AppKit");
+        println!("cargo:rerun-if-changed=public_menu_probe.m");
+    }
     tauri_build::build()
 }
