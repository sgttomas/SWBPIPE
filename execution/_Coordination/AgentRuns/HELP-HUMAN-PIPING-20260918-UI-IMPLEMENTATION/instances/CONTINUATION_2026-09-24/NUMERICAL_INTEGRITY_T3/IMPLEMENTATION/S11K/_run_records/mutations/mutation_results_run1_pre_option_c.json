 {
  "mutant": "M6",
  "mutation": "Replace round() with an ascending naive sum",
  "patch": [
   {
    "file": "solver/frame_kernel/src/exact_sum.rs",
    "old": "    let mut accumulator = ExactAccumulator::new();\n    for value in values {\n        accumulator.add(value)?;\n    }\n    accumulator.round()\n}\n\n/// Correctly rounded sum of exact products",
    "new": "    let mut v: Vec<f64> = values.into_iter().collect();\n    if v.iter().any(|x| !x.is_finite()) { return Err(SumError::NonFinite); }\n    v.sort_by(|a, b| a.abs().total_cmp(&b.abs()));\n    Ok(v.iter().fold(0.0, |s, x| s + x) + 0.0)\n}\n\n/// Correctly rounded sum of exact products"
   }
  ],
  "runs": {
   "all": {
    "command": "cargo test --offline --locked --lib",
    "exit": 101,
    "failed_tests": [
     "exact_sum::tests::k1_cancellations_of_three_or_more_terms",
     "exact_sum::tests::k1_probe_d_is_correctly_rounded_where_ascending_naive_sum_is_not",
     "exact_sum::tests::k1_seeded_random_sums_match_fraction_reference",
     "exact_sum::tests::k1_ties_overflow_adjacent_and_subnormal_nets",
     "structural::exact_boundary::s11k_tests::k8_force_coverage_accepts_the_correctly_rounded_net_and_refuses_corruption",
     "structural::exact_boundary::s11k_tests::k8_stiffness_coverage_accepts_the_correctly_rounded_net_and_refuses_corruption",
     "structural::s11k_tests::k7_audit_flags_every_probe_a_row_from_1e5_and_the_full_route_passes"
    ],
    "compile_error": false
   }
  }
 },
