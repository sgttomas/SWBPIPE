+#[path = "../../../../tests/retained_k4/certificate_arithmetic_tests.rs"]
+mod tests;
diff --git a/projects/chirality-piping/core/solver/frame_kernel/tests/retained_k4/certificate_arithmetic_tests.rs b/projects/chirality-piping/core/solver/frame_kernel/tests/retained_k4/certificate_arithmetic_tests.rs
