        "319: /// Item 6a's coupling in binary64: \u00ea_fo = max(E_fo, fl(E_mo/L_b)),",
        "320: /// \u00ea_mo = max(E_mo, fl(L_b\u00b7E_fo)); a single-node body (L_b = 0) keeps E.",
        "321: pub fn e_hat(e: [f64; 2], extent: f64) -> [f64; 2] {",
        "322:     // V-K seeded fault VK-R02 (R7-M2): \u00ea uncoupled.",
        "323:     #[cfg(any(test, feature = \"mutation-controls\"))]",
        "324:     if super::seeded::active(super::seeded::Fault::R02) {",
        "325:         return e;",
        "326:     }",
        "327:     if extent == 0.0 {",
        "328:         return e;",
        "329:     }",
        "330:     let [fo, mo] = e;",
        "331:     [fo.max(mo / extent), mo.max(extent * fo)]",
        "332: }",
        "333: ",
        "334: /// \u00ea per body from finite E (item 6a). An \u00ea that overflows binary64 while E",
        "335: /// encodes (fl(L_b\u00b7E_fo) or fl(E_mo/L_b) beyond the range) is the same",
        "336: /// terminal case as E's own overflow (ROOT's A3b ruling): V, the estimate's",
        "337: /// threshold and the charge's allowance would be infinite, and no precision",
        "338: /// can pass, so the verification stops with `ResolutionScale` (F2a:",
        "339: /// `receipt_encoding`).",
        "340: pub fn resolution_hats(",
        "341:     resolution: &[[f64; 2]],",
        "342:     extents: &[f64],",
        "343: ) -> Result<Vec<[f64; 2]>, AttemptStop> {",
        "344:     resolution",
        "345:         .iter()",
        "346:         .zip(extents)",
        "347:         .enumerate()",
        "348:         .map(|(b, (e, &extent))| {",
        "349:             let hat = e_hat(*e, extent);",
        "350:             for (kind, v) in [(Kind::Force, hat[0]), (Kind::Moment, hat[1])] {",
        "351:                 if !v.is_finite() {",
        "352:                     return Err(AttemptStop::ResolutionScale {",
        "353:                         body: b as u32,",
        "354:                         kind,",
        "355:                     });",
        "356:                 }",
        "357:             }"
      ]
    },
