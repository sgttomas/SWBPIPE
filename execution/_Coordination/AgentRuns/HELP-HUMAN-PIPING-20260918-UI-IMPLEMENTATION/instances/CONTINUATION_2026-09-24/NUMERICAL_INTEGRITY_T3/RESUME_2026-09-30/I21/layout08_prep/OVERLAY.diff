+//! Archive-only I21 layout08: no solver/model/thread or input parsing.
+//! The entire registered-allocator path is main -> fixed hook -> scalar samples.
+//! All output is after all baseline-to-drop trials have finished.
+#[path = "../src/bin/k6_observe/alloc.rs"]
+mod alloc;
+
+#[global_allocator]
+static ALLOC: alloc::K6Alloc = alloc::K6Alloc;
+
+use open_pipe_stress_frame_kernel::structural::retained_api;
+use std::mem::{align_of, size_of};
+
+fn main() {
+    let layouts = [
+        (size_of::<(u32, retained_api::SpringKind)>(), align_of::<(u32, retained_api::SpringKind)>()),
+        (size_of::<retained_api::Dof>(), align_of::<retained_api::Dof>()),
+        (size_of::<(u32, u64, u64)>(), align_of::<(u32, u64, u64)>()),
+        (size_of::<(u32, f64)>(), align_of::<(u32, f64)>()),
+        (size_of::<(u32, u64)>(), align_of::<(u32, u64)>()),
+    ];
+    let (bytes, calls, contents) =
+        retained_api::i21_layout08_node_requests(alloc::current, alloc::calls);
+
+    // All three trials have ended. Validate without any heap report/format.
+    let mut node_requests = [None; 3];
+    let mut all_bound = !cfg!(test) && !cfg!(debug_assertions);
+    for i in 0..3 {
+        let m = bytes[i];
+        let c = calls[i];
+        let leaf = m[1].checked_sub(m[0]);
+        let split = m[3].checked_sub(m[2]);
+        let internal = split.and_then(|delta| leaf.and_then(|l| delta.checked_sub(l)));
+        let total = leaf.and_then(|l| l.checked_mul(2))
+            .and_then(|twice| internal.and_then(|v| twice.checked_add(v)));
+        let valid = !cfg!(test) && !cfg!(debug_assertions) && contents[i]
+            && c[1].checked_sub(c[0]) == Some(1)
+            && c[2] == c[1] && m[2] == m[1]
+            && c[3].checked_sub(c[2]) == Some(2)
+            && c[4] == c[3] && m[4] == m[0]
+            && leaf.is_some_and(|v| v > 0)
+            && internal.is_some_and(|v| v > 0)
+            && total == m[3].checked_sub(m[0]);
+        node_requests[i] = if valid { leaf.zip(internal) } else { None };
+        all_bound &= valid;
+    }
+
+    // First formatting/output: no measured container or sampling window remains.
+    println!("I21_LAYOUT08 cfg_test={} debug_assertions={}", cfg!(test), cfg!(debug_assertions));
+    let tree_labels = ["geometry_u32_usize", "tracker_rule_body_kind", "holding_rule_body_kind"];
+    for i in 0..3 {
+        println!("RAW {} bytes={:?} calls={:?} contents={}", tree_labels[i], bytes[i], calls[i], contents[i]);
+        match node_requests[i] {
+            Some((leaf, internal)) => println!("REQUEST {} leaf={} internal={} alignment=UNBOUND", tree_labels[i], leaf, internal),
+            None => println!("NO_BINDING {}", tree_labels[i]),
+        }
+    }
+    let layout_labels = ["NotAssessed_u32_SpringKind", "Dof", "Resolution_u32_u64_u64", "Theta_u32_f64", "Certified_u32_u64"];
+    for i in 0..5 {
+        println!("LAYOUT {} size={} align={}", layout_labels[i], layouts[i].0, layouts[i].1);
+    }
+    println!("RESULT {}", if all_bound { "COUNTERS_AND_CONTENT_PASS" } else { "NO_BINDING" });
+    if !all_bound {
+        std::process::exit(1);
+    }
+}
