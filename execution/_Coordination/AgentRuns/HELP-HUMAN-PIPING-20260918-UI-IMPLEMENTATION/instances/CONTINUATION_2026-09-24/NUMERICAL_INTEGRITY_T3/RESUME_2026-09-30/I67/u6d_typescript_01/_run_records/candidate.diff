+      const match = /±(\S+) (\S+), below/.exec(label!)!;
+      expect(Number(match[1])).toBeGreaterThanOrEqual(decodeBinary64(c.bound_bits!));
+      expect(match[2]).toBe({ mm: "m", MPa: "Pa", kN: "N" }[row.unit] ?? row.unit);
