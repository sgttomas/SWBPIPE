+    assert!(exact < late && late < complete, "N1: exact selection, then G-B's outcome, then G-C");
+    assert!(run[exact..late].contains("Err(W1Fallback::Coexistence)") && run[late..complete].contains("Err(W1Fallback::LateGate(refusal))"));
