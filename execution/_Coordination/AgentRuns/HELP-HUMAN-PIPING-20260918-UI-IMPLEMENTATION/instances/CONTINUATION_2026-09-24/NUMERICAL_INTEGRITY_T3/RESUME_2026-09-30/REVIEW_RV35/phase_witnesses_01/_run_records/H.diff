+#[test]
+fn six_axis_springs_expose_uc_c_overlap_in_verification_build() {
+    use open_pipe_stress_frame_kernel::structural::retained_api::{
+        layout, Dof, PrimitiveSource, SourceParts, Spring,
+    };
+    use open_pipe_stress_frame_kernel::structural::SparsePattern;
+
+    // VrModelV1's exact node clone and fresh pushed spring array. Each invented
+    // positive unit spring supports one of the node's six unconstrained DOFs.
+    let nodes = vec![[0.0, 0.0, 0.0]];
+    let mut springs = Vec::new();
+    for g in 0..6 {
+        springs.push(Spring {
+            id: g as u32,
+            dof: Dof::from_global(g),
+            stiffness: 1.0,
+        });
+    }
+    let source = PrimitiveSource::new(SourceParts {
+        nodes: nodes.clone(),
+        springs,
+        ..SourceParts::default()
+    })
+    .unwrap();
+    assert!(source.members().is_empty());
+    assert!(source.directional_springs().is_empty());
+    assert!(source.constraints().is_empty());
+    assert!(source.loads().is_empty());
+    assert!(source.stations().is_empty());
+    assert!(source.supports().is_empty());
+    let free = source.free_dofs();
+    assert_eq!(free, [0, 1, 2, 3, 4, 5]);
+    assert_eq!(source.body_count(), 1);
+
+    // Structure::new (retained/assemble.rs) adds only these spring diagonals.
+    // The public SparsePattern builder gives their actual symmetric closure.
+    let pattern = SparsePattern::from_positions(
+        source.dof_count(),
+        source.springs().iter().map(|s| {
+            let g = s.dof.global();
+            (g, g)
+        }),
+    )
+    .unwrap();
+    for &g in &free {
+        assert_eq!(pattern.row(g), &[g]);
+    }
+    // Thus every free row is a singleton component (bound.rs::free_blocks).
+    // Under any RCM order its skyline has one entry (factor.rs::order_free).
+    let free_blocks = free.len();
+    let profile_entries = free.len();
+    let quantities = layout(&source).len();
+    let encoding_bytes = source.encoding().len();
+    assert_eq!(
+        (
+            pattern.entry_count(),
+            profile_entries,
+            free_blocks,
+            quantities,
+            encoding_bytes
+        ),
+        (6, 6, 6, 13, 164)
+    );
+    let e = evaluate(
+        KernelInput {
+            nodes: source.node_count() as u128,
+            members: 0,
+            axis_springs: source.springs().len() as u128,
+            directional_springs: 0,
+            constraints: 0,
+            load_terms: 0,
+            stations: 0,
+            load_id_bytes: 0,
+            max_load_id_bytes: 0,
+            support_groups: 0,
+            nonzero_prescribed_terms: 0,
+            structure: Some(StructuralCounts {
+                dofs: source.dof_count() as u128,
+                free_dofs: free.len() as u128,
+                quantities: quantities as u128,
+                source_encoding_bytes: encoding_bytes as u128,
+                pattern_entries: pattern.entry_count() as u128,
+                profile_entries: profile_entries as u128,
+            }),
+        },
+        PopulationPolicy::Exact {
+            bodies: source.body_count() as u128,
+            free_blocks: free_blocks as u128,
+        },
+    );
+
+    // Independent owner calculation, in additional heap-request bytes above the
+    // schedule's prepaid retained prefix: verify.rs keeps six 16-byte refusal
+    // slots and a six-u32 row map while bound.rs::uc_bounds retains c across
+    // nl_pass's at, bt and ct. At Wide sizes 48/80/144 this is 96+24+24*w.
+    // The later c/ct/u/n_l alternative is only 24*w; member alternatives are
+    // empty. These fixed-size owners have equal requested and moving bounds.
+    // Isolating this phase prevents a larger unrelated solve maximum masking c.
+    let extra = |schedule: &ScheduleEnvelope, precision| {
+        let value = phase(schedule, KernelPhase::VerificationSharedBuild, precision);
+        bytes(
+            value.requested - schedule.retained_prefix,
+            value.moving - schedule.retained_prefix,
+        )
+    };
+    assert_eq!(
+        [
+            extra(&e.full, 256),
+            extra(&e.full, 512),
+            extra(&e.full, 1024),
+            extra(&e.selected128, 256)
+        ],
+        [
+            bytes(1272, 1272),
+            bytes(2040, 2040),
+            bytes(3576, 3576),
+            bytes(1272, 1272)
+        ]
+    );
+}
