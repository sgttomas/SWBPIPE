+#[test]
+fn missing_input_and_mismatched_counts_are_errors_without_partial_estimates() {
+    let (cases, facts) = load_all_described();
+    let case = cases
+        .iter()
+        .find(|c| c.family == "RF-LARGE" && c.model.is_some())
+        .unwrap();
+    let model = case.model.as_ref().unwrap();
+    let source = PrimitiveSource::new(model.source_parts()).unwrap();
+    let mut counts = scale::counts(model, &source);
+    let inv = VrInvocation::single_case_family_reference(&case.id);
+    assert!(VrEstimateContext::capture(
+        case,
+        model,
+        &source,
+        &counts,
+        FamilyInputFacts::default(),
+        None,
+        inv,
+        PopulationPolicy::NodesAndFreeDofsUpper
+    )
+    .is_err());
+    let family = FAMILY_FILES
+        .iter()
+        .position(|(f, _)| *f == case.family)
+        .unwrap();
+    counts.source_encoding_len += 1;
+    assert!(VrEstimateContext::capture(
+        case,
+        model,
+        &source,
+        &counts,
+        facts[family],
+        None,
+        inv,
+        PopulationPolicy::NodesAndFreeDofsUpper
+    )
+    .is_err());
+}
+
+#[test]
+fn public_type_observations_remain_separate_from_reference_math() {
+    let sizes = scale::Sizes::of_this_build();
+    assert_eq!(
+        (sizes.vk_member, sizes.vk_spring, sizes.vk_load),
+        (112, 88, 48)
+    );
+}
+
+#[test]
+fn missing_scale_is_a_named_cell_not_a_panic_or_zero() {
+    let (mut cases, facts) = load_all_described();
+    let case = cases
+        .iter_mut()
+        .find(|c| c.family == "RF-LARGE" && c.model.is_some())
+        .unwrap();
+    case.scales.clear();
+    let model = case.model.as_ref().unwrap();
+    let source = PrimitiveSource::new(model.source_parts()).unwrap();
+    let counts = scale::counts(model, &source);
+    let family = FAMILY_FILES
+        .iter()
+        .position(|(f, _)| *f == case.family)
+        .unwrap();
+    let context = VrEstimateContext::capture(
+        case,
+        model,
+        &source,
+        &counts,
+        facts[family],
+        None,
+        VrInvocation::single_case_family_reference(&case.id),
+        PopulationPolicy::NodesAndFreeDofsUpper,
+    )
+    .unwrap();
+    assert_eq!(
+        estimate(
+            &context,
+            &ReferenceKernelProfile::source40129_rust1971_aarch64_v1(),
+            &ReferenceVRProfile::source40129_rust1971_aarch64_v1()
+        ),
+        Err(EnvelopeError::MissingDescriptor("row comparison scale"))
+    );
+}
+
+#[test]
+fn absent_argument_history_is_rejected() {
+    let (cases, facts) = load_all_described();
+    let case = cases
+        .iter()
+        .find(|c| c.family == "RF-LARGE" && c.model.is_some())
+        .unwrap();
+    let model = case.model.as_ref().unwrap();
+    let source = PrimitiveSource::new(model.source_parts()).unwrap();
+    let counts = scale::counts(model, &source);
+    let family = FAMILY_FILES
+        .iter()
+        .position(|(f, _)| *f == case.family)
+        .unwrap();
+    let error = VrEstimateContext::capture(
+        case,
+        model,
+        &source,
+        &counts,
+        facts[family],
+        None,
+        VrInvocation::actual("manifest", &case.id, None, ArgumentFacts::default(), false),
+        PopulationPolicy::Exact {
+            bodies: counts.bodies as u128,
+            free_blocks: counts.blocks as u128,
+        },
+    )
+    .err();
+    assert_eq!(
+        error,
+        Some(EnvelopeError::MissingDescriptor(
+            "argument history including argv[0]"
+        ))
+    );
+}
