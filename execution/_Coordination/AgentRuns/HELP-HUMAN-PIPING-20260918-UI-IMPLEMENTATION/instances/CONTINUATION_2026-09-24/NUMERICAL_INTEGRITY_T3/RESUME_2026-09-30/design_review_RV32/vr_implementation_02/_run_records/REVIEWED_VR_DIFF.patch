+fn read(l: N, e: i128) -> N {
+    if l.0 == Some(0) {
+        0.into()
+    } else {
+        (2 * (l + 32)).max(8) + e * l
+    }
+}
+fn hash(l: N, e: i128) -> N {
+    let d = 64 * ((l + 72) / 64);
+    let m = (2 * d).max(8);
+    if e == 0 {
+        m + 144
+    } else {
+        (m + d).max(m + 208)
+    }
+}
+fn encoding(x: N, e: i128) -> N {
+    a(1, x) + e * x
+}
