+#[test]
+fn i23_r09_far_tail_targeted_line6_rounds_up() {
+    // Select the existing frozen vector only; earlier corpus failures must
+    // not mask this required positive far-tail rounding assertion.
+    let line = TARGETED.lines().nth(5).expect("I23 R09 corpus line 6");
+    let (lhs, expected) = line.split_once(" = ").unwrap();
+    let fields: Vec<&str> = lhs.split_whitespace().collect();
+    assert_eq!(&fields[..4], &["sum", "4", "128", "3"], "I23 R09 selector");
+    let precision = fields[2].parse::<u32>().unwrap();
+    let terms = &fields[4..];
+    assert_eq!(terms, &["w:+8p0", "w:+8p-128", "w:+8p-428"], "I23 R09 terms");
+    assert_eq!(expected, "+80000000000000000000000000000001p0", "I23 R09 oracle identity");
+    // The qualifying assertion is run_targeted's existing tok(&v)==expected,
+    // with exactly these three terms at p128; a refusal/setup panic is no kill.
+    assert!(run_targeted::<4>(precision, terms, expected), "I23 R09 no refusal");
+}
