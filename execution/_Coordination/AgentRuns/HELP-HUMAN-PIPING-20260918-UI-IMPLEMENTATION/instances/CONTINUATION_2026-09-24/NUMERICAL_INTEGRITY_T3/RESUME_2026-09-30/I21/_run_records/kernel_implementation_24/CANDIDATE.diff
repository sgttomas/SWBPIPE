+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EnvelopeError {
+    MissingDescriptor(&'static str),
+    InvalidDescriptor(&'static str),
+    MissingProof(&'static str),
+    ArithmeticOverflow,
+    ReferenceWidthExceeded,
+    InternalPhaseCapacity,
+}
