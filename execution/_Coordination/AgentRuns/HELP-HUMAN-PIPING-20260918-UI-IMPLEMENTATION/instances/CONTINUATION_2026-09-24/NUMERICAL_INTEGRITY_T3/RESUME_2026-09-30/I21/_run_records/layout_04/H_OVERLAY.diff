+// One-off H actual-type layout diagnostic. No model or solver construction.
+use open_pipe_stress_solver_performance_harness as h;
+use open_pipe_stress_frame_kernel::structural::retained_api as r;
+fn main() {
+    println!("meta\tsource\tcb13fcf3ea560c0d07ad9ac02dac78e9d2e06e00");
+    println!("meta\tarch\t{}", std::env::consts::ARCH);
+    println!("meta\tos\t{}", std::env::consts::OS);
+    println!("meta\tdebug_assertions\t{}", cfg!(debug_assertions));
+    println!("meta\tcfg_test\t{}", cfg!(test));
+    macro_rules! row {
+        ($label:literal, $ty:ty) => {
+            println!("layout\t{}\t{}\t{}\t{}", $label,
+                std::any::type_name::<$ty>(), std::mem::size_of::<$ty>(), std::mem::align_of::<$ty>());
+        };
+    }
+    row!("H.K6Model", h::k6::models::K6Model);
+    row!("H.Family", h::k6::models::Family);
+    row!("H.PrecisionWork", h::k6::w1::staged::PrecisionWork);
+    row!("H.Segment", h::k6::w1::staged::Segment);
+    row!("STD.OsString", std::ffi::OsString);
+    row!("FK.Crosscheck.RetainedSolve", r::RetainedSolve);
+    row!("FK.Crosscheck.AttemptRecord", r::AttemptRecord);
+    row!("FK.Crosscheck.PublishedRow", r::PublishedRow);
+}
