+        "supports": [{"id": "support:section-a", "node": a, "family": "anchor", "restraints": ["UX", "UY", "UZ", "RX", "RY", "RZ"], "provenance": p}],
+        "load_cases": [{"id": "case:source-section", "provenance": p, "primitive_loads": [
