+    for (bytes, _) in [profile::SPARSE.unwrap(), profile::DENSE.unwrap()] {
+        assert!(bytes + r <= 3_623_878_656, "{} above 0.9 M", bytes + r);
+    }
+    assert!(profile::DENSE.unwrap().0 >= profile::SPARSE.unwrap().0, "the dense parity tail");
+}
