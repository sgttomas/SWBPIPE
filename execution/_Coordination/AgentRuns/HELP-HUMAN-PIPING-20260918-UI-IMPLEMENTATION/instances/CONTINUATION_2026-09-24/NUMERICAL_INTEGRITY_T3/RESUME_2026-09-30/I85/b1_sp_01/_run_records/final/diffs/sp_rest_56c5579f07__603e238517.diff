+    let refused = |observer: rp::ProductCapture, ordinary: MechanicsEnvelope, attempted: &[usize]| -> String {
+        match observer.prepare_cases(ordinary, 3, attempted) {
+            Ok(_) => panic!("custody passed: {attempted:?}"),
+            Err(failure) => {
