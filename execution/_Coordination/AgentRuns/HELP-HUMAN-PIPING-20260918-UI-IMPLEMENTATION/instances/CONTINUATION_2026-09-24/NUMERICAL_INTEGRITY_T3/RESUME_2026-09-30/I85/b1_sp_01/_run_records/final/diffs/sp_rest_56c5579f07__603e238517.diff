+            assert!(hooks::armed_names().is_empty(), "{mode:?}: every armed fault fired");
+            (String::from_utf8(serde_json::to_vec(&envelope).unwrap()).unwrap(), retained.err())
+        };
+        assert_eq!(crate::retained_memory::caps::LOAD_CASES, W_C2_IDS.len(), "I2: C = 3");
