+                            vec![Some(s::RULE_QUANTITY_NOT_COVERED); rows.len()]
+                        }
+                    };
+                    assert!(want.contains(&None) || expected["binding"] != "by_validated_class", "{id}");
+                    assert_eq!(got, want, "{id}");
+                }
+                other => panic!("{other}"),
+            }
+        }
+    }
+}
