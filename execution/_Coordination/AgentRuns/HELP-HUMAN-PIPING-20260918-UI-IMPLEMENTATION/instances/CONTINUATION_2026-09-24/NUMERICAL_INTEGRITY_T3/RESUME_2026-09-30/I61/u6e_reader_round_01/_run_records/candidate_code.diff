+        let stages = |r: &str| -> Value {
+            Value::Object(order.iter().zip(r.chars()).map(|(k, m)| (k.clone(), table["marks"][m.to_string().as_str()].clone())).collect())
+        };
+        let mut kinds: Vec<String> = table["kinds"].as_object().unwrap().keys().cloned().collect();
