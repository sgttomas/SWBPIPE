+def _resealed(doc, edits):
+    """A real milestone receipt edited and resealed like a corpus entry (rehash "all")."""
+    return apply_entry({"source": doc["source"], "invocation": doc["invocation"]}, {"id": "u6e", "edits": edits, "rehash": "all"})
+
