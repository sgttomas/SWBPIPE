        "481: /// Every directional spring's block at the context's precision.",
        "482: pub(crate) fn form_directional<const L: usize>(",
        "483:     ctx: &mut WideContext<L>,",
        "484:     sum: &mut ExactWideSum,",
        "485:     source: &PrimitiveSource,",
        "486: ) -> Result<Vec<DirectionalBlock<L>>, AttemptStop>",
        "487: where",
        "488:     Wide<L>: SupportedWidth,",
        "489: {",
        "490:     let zero = Wide::<L>::ZERO;",
        "491:     let mut out = Vec::with_capacity(source.directional_springs().len());",
        "492:     for s in source.directional_springs() {",
        "493:         let n = [",
        "494:             lift::<L>(s.direction[0])?,",
        "495:             lift::<L>(s.direction[1])?,",
        "496:             lift::<L>(s.direction[2])?,",
        "497:         ];",
        "498:         let norm2 = dot(ctx, sum, &n, &n)?;",
        "499:         let k = lift::<L>(s.stiffness)?;",
        "500:         let mut block = [[zero; 3]; 3];",
        "501:         for a in 0..3 {",
        "502:             for b in a..3 {",
        "503:                 sum.clear();",
        "504:                 sum.add_product(ctx, &n[a], &n[b], false)?;",
        "505:                 let m = sum.round(ctx)?;",
        "506:                 let km = ctx.mul(&k, &m)?;",
        "507:                 let v = ctx.div(&km, &norm2)?;",
        "508:                 // V-K seeded fault VK-S1: k\u00b7n\u00b7n\u1d40 without the division by n\u1d40n.",
        "509:                 #[cfg(any(test, feature = \"mutation-controls\"))]",
        "510:                 let v = if super::seeded::active(super::seeded::Fault::S1) {",
        "511:                     km",
        "512:                 } else {",
        "513:                     v",
        "514:                 };",
        "515:                 block[a][b] = v;",
        "516:                 block[b][a] = v;",
        "517:             }",
        "518:         }",
        "519:         out.push(DirectionalBlock {",
        "520:             node: s.node,",
        "521:             kind: s.kind,",
        "522:             k: block,",
        "523:         });",
        "524:     }",
        "525:     Ok(out)"
      ]
    },
