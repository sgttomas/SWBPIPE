+                lower,
+                upper,
+                t_lo,
+                t,
+                t_hi,
+                e_hat,
+                g_hat,
+                ..
+            } => {
+                assert!(interpolation);
+                assert_eq!((lower, upper), (1, 2));
+                assert_eq!((t_lo, t, t_hi), (300.0, 425.0, 500.0));
