+impl ProductUnit {
+    fn normalize(self, y: f64) -> f64 {
+        match self {
+            Self::Millimetre => y / 1000.0,
+            Self::Megapascal => y * 1_000_000.0,
+            _ => y,
+        }
+    }
+}
