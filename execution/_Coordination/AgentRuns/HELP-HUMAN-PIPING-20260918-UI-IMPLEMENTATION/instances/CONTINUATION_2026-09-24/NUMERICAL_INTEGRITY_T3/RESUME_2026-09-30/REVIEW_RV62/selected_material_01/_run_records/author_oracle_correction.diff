+    assert c['load_case_id']==case and c['intensified_measures']==[]
+    assert c['stress_maximum_coverage']=={'complete':True,'unavailable_pipe_ids':[],'outside_domain_pipe_ids':[]}
+    support_ids=[x['id'] for x in request['model']['supports']]
+    assert c['support_attribution']=={'attributed_support_ids':support_ids,'withheld':[]}
+    assert len(c['pipe_stress_extrema'])==len(request['model']['pipe_segments'])==1
+    midpoints=[]
+    for x in c['pipe_stress_extrema']:
+        assert set(x)=={'pipe_id','result_id','station_fraction','span_index','local_fraction','value_lower_pa','value_upper_pa','global_upper_bound_pa','certified_gap_pa','subdivisions','approximation','coefficient_basis','enclosure_scope'}
+        row=next(r for r in rows if r['id']==x['result_id'])
+        assert row['entity_ref']==x['pipe_id'] and row['kind']=='pipe_elastic_normal_stress_maximum_v2'
+        lo,hi=x['value_lower_pa'],x['value_upper_pa']
+        midpoint=float(Q(lo)+Q(float(Q(1,2)*Q(float(Q(hi)-Q(lo))))))
+        assert 0<=lo<=row['value']<=hi and bits(midpoint)==bits(row['value'])
+        assert all(0<=x[k]<=1 for k in ['station_fraction','local_fraction'])
+        assert x['span_index']>=0 and x['span_index']==int(x['span_index'])
+        assert 0<=x['subdivisions']<=131072 and x['subdivisions']==int(x['subdivisions'])
+        assert x['approximation']=='piecewise_quadratic_straight_section_statics'
+        assert x['coefficient_basis']=='j_side_section_equilibrium_binary64'
+        assert x['enclosure_scope']=='supplied_binary64_polynomial_coefficients; solution and coefficient formation error are separate'
+        assert all(math.isfinite(x[k]) for k in ['value_lower_pa','value_upper_pa','global_upper_bound_pa','certified_gap_pa'])
+        midpoints.append({'id':row['id'],'midpoint_bits':bits(midpoint)})
+    guards=[]
