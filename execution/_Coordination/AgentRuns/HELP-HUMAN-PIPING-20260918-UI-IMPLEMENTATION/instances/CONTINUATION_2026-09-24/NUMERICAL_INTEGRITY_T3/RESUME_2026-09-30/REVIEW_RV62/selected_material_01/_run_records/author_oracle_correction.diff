+        for names,kind in [('F','support_reaction_force_magnitude_v2'),('M','support_reaction_moment_magnitude_v2')]:
+            values=[components[names+a] for a in ['x','y','z']]
+            squared=sum((Q(v)*Q(v) for v in values),Q(0));interval=rootq(squared)
+            row=next(r for r in rows if r['entity_ref']==support and r['kind']==kind)
+            tolerance=Q(64)*Q(2)**-52*max(abs(Q(row['value'])),Q(2)**-1022)
+            error=distance_bounds(row['value'],interval)[1]
