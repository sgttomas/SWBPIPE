+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub(super) struct CertificateComponents {
+    pub(super) r7: u64,
+    pub(super) context: u64,
+    pub(super) sums: u64,
+    pub(super) total: u64,
+}
