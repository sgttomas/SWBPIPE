+    sum.signum().unwrap();
+    sum.test_seed_term_work(u64::MAX);
+    let mut work = NumericWork::new();
+    let result = scalar_owned(
+        &mut work,
+        Entry::Div,
+        &Endpoint::ONE,
+        &Endpoint::ZERO,
+        Toward::Up,
+        WideContext::<16>::new(1024).unwrap(),
