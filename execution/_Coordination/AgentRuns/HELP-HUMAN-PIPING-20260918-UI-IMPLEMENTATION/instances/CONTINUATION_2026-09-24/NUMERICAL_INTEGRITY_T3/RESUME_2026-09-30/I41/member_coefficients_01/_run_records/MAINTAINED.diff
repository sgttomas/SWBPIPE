+}
+#[derive(Debug, Clone, PartialEq)]
+pub(super) enum NumericError {
+    Arithmetic(AttemptStop),
+    NonFinite,
+    NonpositiveSource,
+    InvalidGeometry,
+    InvalidMaterial,
+    MaterialBits,
+    TemperatureOrder,
+    NonpositiveDenominator,
+    AxisBits,
+    Binary64Range,
+}
+impl From<AttemptStop> for NumericError {
+    fn from(e: AttemptStop) -> Self {
+        Self::Arithmetic(e)
+    }
+}
