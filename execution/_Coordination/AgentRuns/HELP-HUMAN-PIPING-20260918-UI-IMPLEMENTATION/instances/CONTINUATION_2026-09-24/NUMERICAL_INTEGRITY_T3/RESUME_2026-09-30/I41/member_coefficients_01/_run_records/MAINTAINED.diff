+    assert!(work
+        .scalar(Entry::Add, &huge, &Endpoint::ONE, Toward::Up)
+        .is_err());
+    assert_eq!(work.entries[Entry::Add as usize].exact(), Ok(1));
+    assert!(work.sums.checked_lme().exact().unwrap() > 0);
+    let mut sum = ExactWideSum::new();
