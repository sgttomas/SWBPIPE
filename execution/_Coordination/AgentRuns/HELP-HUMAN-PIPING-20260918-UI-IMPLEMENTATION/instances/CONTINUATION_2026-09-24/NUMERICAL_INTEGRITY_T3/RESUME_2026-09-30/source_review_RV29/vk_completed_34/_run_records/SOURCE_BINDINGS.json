      "lines": [
        "86: impl RetainedLedger {",
        "87:     /// One `ExactAccumulator` per loaded DOF, one `add` per nodal load.",
        "88:     pub(crate) fn from_source(source: &PrimitiveSource) -> Result<Self, LedgerRefusal> {",
        "89:         // V-K seeded fault VK-F13 (\u00a77.3-13): the loads folded at p = 128 in",
        "90:         // listed order instead of the exact ledger.",
        "91:         #[cfg(any(test, feature = \"mutation-controls\"))]",
        "92:         if super::seeded::active(super::seeded::Fault::F13) {",
        "93:             let mut entries: Vec<(usize, ExactAccumulator, bool)> = Vec::new();",
        "94:             for (dof, terms, nonzero) in super::seeded::folded_loads(source) {",
        "95:                 let mut accumulator = ExactAccumulator::new();",
        "96:                 for term in terms {",
        "97:                     accumulator.add(term).map_err(LedgerRefusal::Accumulator)?;",
        "98:                 }",
        "99:                 entries.push((dof, accumulator, nonzero));",
        "100:             }",
        "101:             return Ok(Self::netted(&entries));",
        "102:         }",
        "103:         let mut entries: Vec<(usize, ExactAccumulator, bool)> = Vec::new();"
      ]
    },
    {
      "path": "projects/chirality-piping/core/solver/frame_kernel/src/structural/retained/seeded.rs",
      "sha256": "ce8069a705d7dd7a0ea7a87fa82180757d804b0bd7268097cf5859f8e1a3a0f8",
      "range": [
        94,
        124
      ],
      "lines": [
        "94: /// VK-F13: each loaded DOF's contributions folded one by one at p = 128 in",
        "95: /// the source's canonical (listed) order, each partial sum rounded to 128",
        "96: /// bits, then split exactly into binary64 terms for the ledger's accumulator.",
        "97: /// (DOF, terms, whether any contribution is nonzero), DOFs ascending.",
        "98: pub(crate) fn folded_loads(source: &PrimitiveSource) -> Vec<(usize, Vec<f64>, bool)> {",
        "99:     let mut arith = WideArith::new(128).expect(\"p = 128\");",
        "100:     let mut out: Vec<(usize, Vec<f64>, bool)> = Vec::new();",
        "101:     let mut current: Option<(usize, Wide2, bool)> = None;",
        "102:     let lift = |v: f64| Wide2::from_f64(v).expect(\"finite load\");",
        "103:     let close = |entry: (usize, Wide2, bool), out: &mut Vec<(usize, Vec<f64>, bool)>| {",
        "104:         let split = entry.1.split_binary64().expect(\"in range\");",
        "105:         out.push((entry.0, split.terms().to_vec(), entry.2));",
        "106:     };",
        "107:     for load in source.loads() {",
        "108:         let dof = load.dof.global();",
        "109:         current = Some(match current.take() {",
        "110:             Some((d, partial, nonzero)) if d == dof => (",
        "111:                 d,",
        "112:                 arith.add(&partial, &lift(load.value)).expect(\"fold at 128\"),",
        "113:                 nonzero || load.value != 0.0,",
        "114:             ),",
        "115:             Some(done) => {",
        "116:                 close(done, &mut out);",
        "117:                 (dof, lift(load.value), load.value != 0.0)",
        "118:             }",
        "119:             None => (dof, lift(load.value), load.value != 0.0),",
        "120:         });",
        "121:     }",
        "122:     if let Some(done) = current {",
        "123:         close(done, &mut out);",
        "124:     }"
      ]
    },
