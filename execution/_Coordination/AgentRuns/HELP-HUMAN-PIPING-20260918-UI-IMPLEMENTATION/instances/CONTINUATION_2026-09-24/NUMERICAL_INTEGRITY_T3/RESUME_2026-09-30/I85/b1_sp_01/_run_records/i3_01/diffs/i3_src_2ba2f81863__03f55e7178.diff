+/// W-C2's cases and RV109's A2 (a copy of case A, `case-a2`, its load ids suffixed `:a2`), the
+/// cases `ids`, in that order, as one request.
+fn w_c2_plus_a2(ids: &[&str]) -> Value {
+    let mut raw = w_c2();
+    let mut a2 = raw["model"]["load_cases"][0].clone();
+    a2["id"] = json!("case-a2");
