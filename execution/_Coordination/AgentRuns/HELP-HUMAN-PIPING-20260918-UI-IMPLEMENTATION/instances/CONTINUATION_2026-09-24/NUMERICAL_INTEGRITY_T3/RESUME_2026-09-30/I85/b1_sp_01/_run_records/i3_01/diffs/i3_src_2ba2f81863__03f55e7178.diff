+    }
+    raw["model"]["load_cases"].as_array_mut().unwrap().push(a2);
+    let all = raw["model"]["load_cases"].as_array().unwrap().clone();
+    raw["model"]["load_cases"] = json!(ids.iter().map(|id| all.iter().find(|c| c["id"] == *id).unwrap().clone()).collect::<Vec<_>>());
