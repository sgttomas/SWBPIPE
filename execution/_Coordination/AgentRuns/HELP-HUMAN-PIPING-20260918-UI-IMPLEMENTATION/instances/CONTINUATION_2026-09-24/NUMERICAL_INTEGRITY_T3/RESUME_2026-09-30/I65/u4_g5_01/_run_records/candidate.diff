+/// A gate's refusal: the gate, the first fact above its bound, the observed
+/// value (saturated at `u64::MAX` when a sum overflows) and the bound.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct PhaseRefusal {
