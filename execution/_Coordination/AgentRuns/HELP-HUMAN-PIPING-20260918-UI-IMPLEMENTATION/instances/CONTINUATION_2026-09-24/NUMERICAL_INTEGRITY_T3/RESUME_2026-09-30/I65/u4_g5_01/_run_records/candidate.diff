+        let (observed, cap) = at(fact);
+        assert_eq!(observed, cap, "{fact:?}");
+    }
+    assert_eq!(at(CapFact::LoadsCapacity).1, 128, "l ≤ 128 (RR \"U4 G4\")");
+}
