+/// RV93 probe only (never committed): record each permit `admission` grants, unconditionally
+/// (production and test builds), when RV93_PERMIT_LOG names a file.
+fn rv93_permit_log(report: &RetainedAdmissionReport) {
+    if let Some(path) = std::env::var_os("RV93_PERMIT_LOG") {
+        use std::io::Write;
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(f, "PERMIT caller={:?} profile={:?} exe={:?} thread={:?}", report.caller, report.profile,
+                std::env::current_exe().ok().and_then(|p| p.file_name().map(|n| n.to_owned())), std::thread::current().name());
         }
     }
