+#[test]
+fn i23_r7_g_scope() {
+    // CHARGE's G-FIXED-MEMBER 256 header records no g_violation and its
+    // chgcount records g_max=0. The fixed member is outside the g scope.
+    let r = i23_report256("G-FIXED-MEMBER");
+    assert_eq!(r.g_max, 0, "I23:G_SCOPE");
+    assert_eq!(r.g_violation, None, "I23:G_SCOPE_VIOLATION");
+}
