+#[test]
+fn i23_r7_prescribed_e_matches_scale() {
+    // R7-M5 changes verify_state's |u| input. scale_at alone calls the
+    // formation helper outside verify_state and cannot exercise that fault.
+    // PRESCRIBED's SCALE record includes all 33 force/moment E rows and the
+    // body's uncoupled resolution bits. Compare the verifier's fields directly.
+    let name = "PRESCRIBED";
+    let recs = records(include_str!("scale.txt"), name, 256);
+    let expected_rows: Vec<_> = recs.iter().filter(|f| f[0] == "erow").collect();
+    let expected_bodies: Vec<_> = recs.iter().filter(|f| f[0] == "ebody").collect();
+    assert_eq!(expected_rows.len(), 33, "I23 SCALE E-row precondition");
+    assert_eq!(expected_bodies.len(), 1, "I23 SCALE body precondition");
+    let r = i23_report256(name);
+    let actual_indices: Vec<_> = r.e_rows.iter().enumerate()
+        .filter_map(|(index, value)| value.as_ref().map(|_| index)).collect();
+    let expected_indices: Vec<_> = expected_rows.iter()
+        .map(|fields| fields[3].parse::<usize>().unwrap()).collect();
+    assert_eq!(actual_indices, expected_indices, "I23:R7M5_E_ROW_COVERAGE");
+    for fields in expected_rows {
+        let index = fields[3].parse::<usize>().unwrap();
+        let expected = support::parse::<4>(fields[4]);
+        assert_eq!(r.e_rows[index], Some(expected), "I23:R7M5_E_ROW:{index}");
+    }
+    assert_eq!(r.resolution.len(), 1, "I23 fixture resolution shape");
+    for fields in expected_bodies {
+        let body = fields[3].parse::<usize>().unwrap();
+        let expected = [u64::from_str_radix(fields[4], 16).unwrap(),
+                        u64::from_str_radix(fields[5], 16).unwrap()];
+        assert_eq!(r.resolution[body].map(f64::to_bits), expected,
+            "I23:R7M5_RESOLUTION:{body}");
+    }
+}
