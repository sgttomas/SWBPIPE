+#[test]
+fn i23_r7_required_shift() {
+    for name in ["RF-LARGE-CHAIN-n00100-AX", "RF-LARGE-TREE-n00100-AX"] {
+        // CHARGE records one actually scheduled factorization. BOUNDS has
+        // one block with need=1 and a formed first-try S at the same sigma;
+        // hence its independently emulated S is the actual scheduled S here.
+        let recs = records(include_str!("bounds.txt"), name, 256);
+        let expected: Vec<_> = recs.iter().filter(|f| f[0] == "shf").collect();
+        assert_eq!(expected.len(), 1, "I23 BOUNDS shift-record precondition:{name}");
+        let fields = expected[0];
+        assert_eq!(fields[3], "0", "I23 BOUNDS block precondition:{name}");
+        assert_eq!(fields[5], "1", "I23 BOUNDS first-try precondition:{name}");
+        assert_ne!(fields[9], "-", "I23 BOUNDS available-S precondition:{name}");
+        let expected_s = support::parse::<4>(fields[9]);
+        let r = i23_report256(name);
+        assert_eq!(r.shift_factorizations, 1, "I23:REQUIRED_SHIFT:{name}");
+        assert_eq!(r.blocks.len(), 1, "I23 fixture shift block shape:{name}");
+        let actual_s = r.blocks[0].shift.as_ref().and_then(|shift| shift.s);
+        assert_eq!(actual_s, Some(expected_s), "I23:FORMED_SHIFT_BOUND:{name}");
+    }
+}
