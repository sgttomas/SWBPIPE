+#[test]
+fn i23_r7_bound_choice() {
+    // Compare live B directly with the accepted independent CHARGE tokens.
+    // Do not construct expected B from the live report's Uc, S, or estimate.
+    for (name, count) in [("CHARGE-SLENDER", 1usize), ("HH-SLENDER-m40", 3usize)] {
+        let recs = records(CHARGE, name, 256);
+        let expected: Vec<_> = recs.iter().filter(|f| f[0] == "chgblk").collect();
+        assert_eq!(expected.len(), count, "I23 CHARGE record precondition:{name}");
+        let r = i23_report256(name);
+        assert_eq!(r.blocks.len(), count, "I23 fixture block shape:{name}");
+        for (block, fields) in expected.iter().enumerate() {
+            assert_eq!(fields[3].parse::<usize>().unwrap(), block,
+                "I23 CHARGE block-order precondition:{name}");
+            let expected_b = if fields[5] == "-" {
+                None
+            } else {
+                Some(support::parse::<4>(fields[5]))
+            };
+            assert_eq!(r.blocks[block].b, expected_b, "I23:B_CHOICE:{name}:{block}");
+        }
+    }
+}
