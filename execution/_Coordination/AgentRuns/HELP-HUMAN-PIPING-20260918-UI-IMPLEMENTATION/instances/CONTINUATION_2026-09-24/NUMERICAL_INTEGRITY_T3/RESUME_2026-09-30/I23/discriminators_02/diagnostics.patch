+// I23 discriminator proposal: additive tests only, for a separately reviewed
+// disposable baseline. Expectations come from the accepted rule and immutable
+// CHARGE/SCALE/BOUNDS corpus. No expected value comes from a solver run.
+// Precondition/build failures are not semantic kills. Only the mapped I23
+// semantic assertions can discriminate their named fault.
+
+fn i23_report256(name: &str) -> VerificationReport<4> {
+    let all = all_models();
+    let m = all.iter().find(|m| m.name == name).expect("I23 fixture exists");
+    let _seeded = Seeded::new(&m.seeds);
+    let prep = CasePrep::new(m.source()).expect("I23 fixture source");
+    let group = prepare_group(&prep.source).expect("I23 fixture group");
+    let guard = StageGuard::unlimited();
+    let shared = build_shared::<4, 8>(256, 320, &prep.source, &group, guard)
+        .result.expect("I23 baseline build_shared precondition");
+    let state = solve_case_at::<4, 8>(&shared, &prep, &group, guard)
+        .result.expect("I23 baseline solve_case_at precondition");
+    let vs = build_verify_shared::<4, 8, 8>(&shared, &prep.source, &group, guard)
+        .result.expect("I23 baseline build_verify_shared precondition");
+    verify_state::<4, 8, 8>(&shared, &vs, &prep, &group, &state, guard)
+        .result.expect("I23 baseline verify_state precondition")
+}
