+    let close = tail.find("],\"professional_boundary\"").unwrap();
+    let (items, rest) = tail.split_at(close);
+    let sep = if items.is_empty() { "" } else { "," };
+    format!(r#"{head}"diagnostics":[{items}{sep}{}{rest}"#, notice_json(case, detail)).into_bytes()
+}
 
