+    let mut case: Value = serde_json::from_str(&plan.changes[0].after).unwrap();
+    let primitives: Vec<Value> = plan.changes.iter().skip(1).map(|change| serde_json::from_str(&change.after).unwrap()).collect();
+    assert_eq!(primitives.len(),2);
+    case["primitive_loads"] = Value::Array(primitives); model["load_cases"] = json!([case]);
+    for pipe in model["pipe_segments"].as_array_mut().unwrap() { pipe["section"]["material_density"]["value"] = json!(2000); }
