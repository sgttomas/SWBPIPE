+pub(crate) fn validate_pipe_section_inputs(section: &Value) -> Result<bool> {
+    let record = object(
+        section,
+        &[
+            "outside_diameter",
+            "wall_thickness",
+            "material_density",
+            "mill_tolerance",
+            "contents_density",
+            "insulation_thickness",
+            "insulation_density",
