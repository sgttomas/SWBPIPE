+    let direct = apply_operation(&model,&op,Some(&claim(&model)));
+    assert!(direct.applied_model.is_some(),"{:?}",direct.diagnostics);
+    let batch = json!({"batch_id":"full-case","source_model_hash":claim(&model)["value"],"operations":[op]});
+    let imported = apply_operation_batch(&model,&batch,Some(&claim(&model)));
+    assert!(imported["applied_model"].is_object(),"{imported}");
+    assert_eq!(model,original);
