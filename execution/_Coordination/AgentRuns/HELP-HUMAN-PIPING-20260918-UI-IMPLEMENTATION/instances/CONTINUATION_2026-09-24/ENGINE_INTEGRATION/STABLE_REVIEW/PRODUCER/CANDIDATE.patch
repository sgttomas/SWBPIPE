+            0.12,
+            0.01,
+            "material:one"
+        ),
+        pipe(
+            "pipe:B-C",
+            if reverse_second { "node:C" } else { TIP },
+            if reverse_second { TIP } else { "node:C" },
+            0.13,
+            0.015,
+            "material:two"
+        )
+    ]);
+    input["model"]["materials"] = json!([
+        material("material:one", 200e9, 0.3),
+        material("material:two", 100e9, 0.25)
