+    }
+    append(
+        "force_magnitude",
+        "support_reaction_force_magnitude_v2",
+        action[0].hypot(action[1]).hypot(action[2]),
+        "N",
+    );
+    append(
+        "moment_magnitude",
+        "support_reaction_moment_magnitude_v2",
+        action[3].hypot(action[4]).hypot(action[5]),
+        "N*m",
+    );
