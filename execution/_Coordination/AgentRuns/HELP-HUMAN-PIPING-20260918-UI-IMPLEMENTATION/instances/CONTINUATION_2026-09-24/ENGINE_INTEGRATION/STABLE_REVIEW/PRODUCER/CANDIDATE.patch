+        assert_eq!(scaled_ratio(f64::MAX, 1.0, f64::MAX, "test").unwrap(), 1.0);
+        assert_eq!(
+            scaled_ratio(f64::from_bits(1), 1.0, f64::from_bits(1), "test").unwrap(),
