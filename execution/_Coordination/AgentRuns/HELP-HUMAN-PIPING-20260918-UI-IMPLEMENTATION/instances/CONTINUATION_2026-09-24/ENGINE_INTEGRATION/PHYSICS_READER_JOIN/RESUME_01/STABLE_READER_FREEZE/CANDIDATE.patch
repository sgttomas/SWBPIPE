+
+def validate_derived(source: Mapping[str, Any], case: Mapping[str, Any], treatment: Mapping[str, Any], row: Mapping[str, Any], inputs: list[Mapping[str, Any]]) -> None:
+    recipe = treatment["recipe_id"]
