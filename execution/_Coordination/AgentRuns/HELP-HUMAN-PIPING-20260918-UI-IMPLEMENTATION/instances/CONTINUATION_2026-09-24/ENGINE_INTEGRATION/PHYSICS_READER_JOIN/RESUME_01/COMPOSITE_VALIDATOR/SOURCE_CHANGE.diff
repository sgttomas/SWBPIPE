+pub fn validate_transport_metadata(source: &Value) -> Check {
+    let schema: Value =
+        serde_json::from_str(include_str!("../../../../schemas/results.v0.3.schema.yaml"))
+            .map_err(|e| e.to_string())?;
+    let evidence = &source["contract_evidence"];
