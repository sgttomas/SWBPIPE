+// A reference is preserved source evidence, never a browser solve or Current basis.
+async function inspectBundledReference(page: Page) {
+  const solve = await openWorkspaceSection(page, "solve");
+  await activateWithKeyboard(page, solve.getByRole("button", { name: "Inspect bundled reference", exact: true }));
+  await expect(page.getByTestId("workspace-section-results")).toBeVisible();
+  const reference = page.getByRole("region", { name: "Bundled reference — not a solve for the current model", exact: true });
+  await expect(reference).toBeVisible();
+  await expect(reference.getByTestId("result-filter-summary")).toHaveText("830 of 830 results match filter");
+  await expect(page.getByTestId("comparison-summary")).toHaveCount(0);
+  return reference;
+}
+
+async function expectBrowserSolveRefusal(page: Page, diagnostic = "BROWSER_SOLVE_BACKEND_REQUIRED") {
+  await expect(page.getByTestId("solve-job-summary")).toContainText("state=failed");
+  await expect(page.getByTestId("solve-job-summary")).toContainText("result_rows=0");
+  await expect(page.getByTestId("solve-job-error")).toContainText(diagnostic);
+  await expect(page.getByTestId("rule-check-run")).toBeDisabled();
+}
