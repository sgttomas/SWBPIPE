    "UnitWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "source_row_index",
        "result_id",
        "source_quantity",
        "target_quantity",
        "conversion_performed",
        "policy"
      ],
      "properties": {
        "witness_id": {
          "type": "string"
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "result_id": {
          "type": "string"
        },
        "source_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "target_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "conversion_performed": {
          "const": false
        },
        "policy": {
          "const": "preserve_received_value_and_unit"
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "dimension"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ValidationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "check_status",
        "blocking_count",
        "diagnostic_count",
        "provenance"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "check_status": {
          "enum": [
            "passed",
            "blocking"
          ]
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "ValidationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_status",
        "checks",
        "human_review_required",
        "provenance"
      ],
      "properties": {
        "validation_status": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          }
        },
        "human_review_required": {
          "const": true
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "class",
        "severity",
        "source",
        "affected_object",
        "message",
        "remediation",
        "provenance"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reference"
        },
        "affected_object": {
          "$ref": "#/$defs/Reference"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "source_location",
        "source_license",
        "contributor",
        "contributor_certification",
        "redistribution_status",
        "review_status"
      ],
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_location": {
          "type": "string",
          "minLength": 1
        },
        "source_license": {
          "type": "string",
          "minLength": 1
        },
        "contributor": {
          "type": "string",
          "minLength": 1
        },
        "contributor_certification": {
          "type": "string",
          "minLength": 1
        },
        "privacy_classification": {
          "type": "string",
          "minLength": 1
        },
        "redistribution_status": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
