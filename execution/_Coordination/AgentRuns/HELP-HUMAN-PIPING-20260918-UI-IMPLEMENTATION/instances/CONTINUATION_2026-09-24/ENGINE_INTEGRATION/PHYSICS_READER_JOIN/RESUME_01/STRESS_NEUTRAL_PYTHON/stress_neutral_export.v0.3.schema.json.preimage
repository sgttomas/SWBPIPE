                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "filename",
                    "checksum"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ManifestMember"
                },
                {
                  "properties": {
                    "filename": {
                      "const": "validation_report.json"
                    },
                    "checksum": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/CheckedChecksum"
                        },
                        {
                          "properties": {
                            "algorithm": {
                              "const": "sha256"
                            },
                            "canonicalization": {
                              "const": "openpipestress_jcs_ijson_v1"
                            },
                            "payload_scope": {
                              "const": "member_payload"
                            },
                            "payload_ref": {
                              "allOf": [
                                {
