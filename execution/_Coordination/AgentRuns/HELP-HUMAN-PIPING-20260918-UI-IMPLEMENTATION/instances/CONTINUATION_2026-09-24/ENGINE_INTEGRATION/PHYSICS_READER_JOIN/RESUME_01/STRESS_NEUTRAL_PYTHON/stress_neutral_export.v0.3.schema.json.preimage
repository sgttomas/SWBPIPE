                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "filename",
                    "checksum"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ManifestMember"
                },
                {
                  "properties": {
                    "filename": {
                      "const": "stable_id_map.json"
                    },
                    "checksum": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/CheckedChecksum"
                        },
                        {
                          "properties": {
                            "algorithm": {
                              "const": "sha256"
                            },
                            "canonicalization": {
                              "const": "openpipestress_jcs_ijson_v1"
                            },
                            "payload_scope": {
                              "const": "member_payload"
                            },
                            "payload_ref": {
                              "allOf": [
                                {
                                  "$ref": "#/$defs/Reference"
                                },
                                {
                                  "properties": {
                                    "object_type": {
                                      "const": "StressNeutralMember"
                                    },
                                    "ref": {
                                      "const": "stable_id_map.json"
                                    }
                                  },
                                  "required": [
                                    "object_type",
                                    "ref"
                                  ]
                                }
                              ]
                            }
                          },
                          "required": [
                            "algorithm",
                            "canonicalization",
                            "payload_scope",
                            "payload_ref"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "filename",
                    "checksum"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/ManifestMember"
                },
                {
                  "properties": {
                    "filename": {
                      "const": "loss_report.json"
                    },
                    "checksum": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/CheckedChecksum"
                        },
                        {
                          "properties": {
                            "algorithm": {
                              "const": "sha256"
                            },
                            "canonicalization": {
                              "const": "openpipestress_jcs_ijson_v1"
                            },
                            "payload_scope": {
                              "const": "member_payload"
                            },
                            "payload_ref": {
                              "allOf": [
                                {
                                  "$ref": "#/$defs/Reference"
                                },
                                {
                                  "properties": {
                                    "object_type": {
                                      "const": "StressNeutralMember"
                                    },
                                    "ref": {
                                      "const": "loss_report.json"
                                    }
                                  },
                                  "required": [
                                    "object_type",
