/// Independent structural/value/hash accounting check. Strict whole schema is
/// additionally exercised by the version-dispatched schema validation gate.
pub fn validate_document(doc: &Value, source: &Value) -> Result<(), String> {
    guard_json(doc)?;
    guard_json(source)?;
    let (table, version) = for_source(source)?;
    if source["producer"]["semantic_contract_id"] == crate::source_blocks::CONTRACT_ID {
        if doc["result_envelope"]["source_block_recovery"] != source["source_block_recovery"] {
            return Err("SOURCE_BLOCK_RECEIPT_BINDING_MISMATCH".into());
        }
    } else if doc["result_envelope"]
        .get("source_block_recovery")
        .is_some()
    {
        return Err("SOURCE_BLOCKS_LEGACY_DOWNGRADE_FORBIDDEN".into());
    }
    if version == "0.3.0" {
        for key in ["producer", "numerical_quality", "formulation_basis"] {
<<<<<<< JOINED_BEFORE
            if doc["result_envelope"][key] != source[key] { return Err("SOURCE_METADATA_BINDING_MISMATCH".into()); }
        }
        if doc["result_envelope"].get("contract_evidence") != source.get("contract_evidence").filter(|v| !v.is_null()) { return Err("SOURCE_CONTRACT_EVIDENCE_BINDING_MISMATCH".into()); }
        if doc["result_envelope"]["semantic_contract_ref"] != reference("semantic_contract", source["producer"]["semantic_contract_id"].as_str().unwrap()) { return Err("SEMANTIC_CONTRACT_BINDING_MISMATCH".into()); }
    }
    if version == "0.2.0" && ["producer", "numerical_quality", "formulation_basis", "semantic_contract_ref", "contract_evidence"].iter().any(|key| doc["result_envelope"].get(key).is_some()) { return Err("LEGACY_DERIVATIVE_METADATA_CONTRADICTION".into()); }
    if doc["schema_version"]!=version||doc["result_envelope"]["schema_version"]!=version{return Err("DERIVATIVE_VERSION_MISMATCH".into());}
    let e=&doc["result_envelope"];let rows=source["results"].as_array().ok_or("SOURCE_ROWS_MISSING")?;
    let accounts=e["row_accounting"].as_array().ok_or("ACCOUNTING_MISSING")?;
    let annotations=e["source_annotations"].as_array().ok_or("ANNOTATIONS_MISSING")?;
    let sets=e["result_sets"].as_array().ok_or("RESULT_SETS_MISSING")?;
    let reviews=e["review_evidence"].as_array().ok_or("REVIEW_EVIDENCE_MISSING")?;
    let disclosures=e["row_disclosures"].as_array().ok_or("DISCLOSURES_MISSING")?;
    let witnesses=e["unit_preservation_witnesses"].as_array().ok_or("WITNESSES_MISSING")?;
    let origins=e["reproducibility"]["source_origin_bindings"].as_array().ok_or("ORIGINS_MISSING")?;
