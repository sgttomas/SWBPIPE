//! Pure derivative assembly from separately qualified source evidence.
//! This module does not authenticate supplied JSON. The headless solve API and
//! desktop Current adapter own qualification; payload shape never proves origin.
use crate::semantic_contract::{
    canonical_metadata_in, complete_metadata, for_source, signature_in,
};
use open_pipe_stress_canonical_json::canonical_json;
use serde_json::{json, Value};
use sha2::{Digest, Sha256};
use std::collections::HashSet;

pub const CANONICALIZATION: &str = "openpipestress_jcs_ijson_v1";
pub fn guard_json(v: &Value) -> Result<(), String> {
    match v {
        Value::Number(n) => {
            let f = n.as_f64().ok_or("UNSUPPORTED_NUMBER")?;
            if !f.is_finite() || (f.fract() == 0.0 && f.abs() > 9_007_199_254_740_991.0) {
                return Err("UNSAFE_JSON_NUMBER".into());
            }
        }
        Value::Array(a) => {
            for x in a {
                guard_json(x)?;
            }
        }
        Value::Object(o) => {
            for x in o.values() {
                guard_json(x)?;
            }
        }
        _ => {}
    }
    Ok(())
}
pub fn digest(v: &Value) -> Result<String, String> {
    guard_json(v)?;
    Ok(format!(
        "{:x}",
        Sha256::digest(canonical_json(v).as_bytes())
    ))
}
pub fn reference(kind: &str, id: &str) -> Value {
    json!({"ref_type":kind,"ref_id":id})
}
pub fn checksum(v: &Value, scope: &str, payload_ref: Value) -> Result<Value, String> {
    Ok(
        json!({"algorithm":"sha256","canonicalization":CANONICALIZATION,"payload_scope":scope,"payload_ref":payload_ref,"value":digest(v)?}),
    )
}
pub fn legacy_checksum(v: &Value, payload_ref: Value) -> Result<Value, String> {
    Ok(
        json!({"algorithm":"sha256","canonicalization":CANONICALIZATION,"payload_ref":payload_ref,"value":digest(v)?}),
    )
}

