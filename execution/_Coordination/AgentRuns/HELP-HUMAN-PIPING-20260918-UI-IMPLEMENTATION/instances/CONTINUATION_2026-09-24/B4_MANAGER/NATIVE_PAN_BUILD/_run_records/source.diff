+        expect(input).toHaveValue("210000000000"); expect(cell).toHaveTextContent("200000000000");
+        expect(apply).not.toHaveBeenCalled(); expect(queue).not.toHaveBeenCalled();
+        fireEvent.click(screen.getByRole("button", { name: "Cancel" }));
