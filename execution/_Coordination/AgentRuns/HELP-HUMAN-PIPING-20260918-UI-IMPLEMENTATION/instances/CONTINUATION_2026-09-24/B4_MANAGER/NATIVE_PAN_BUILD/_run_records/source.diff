+          if (fireEvent.pointerDown(button)) fireEvent.blur(input, { relatedTarget: null });
+          expect(button).toHaveFocus(); expect(apply).not.toHaveBeenCalled();
+          fireEvent.pointerUp(button);
+        } else act(() => button.focus());
