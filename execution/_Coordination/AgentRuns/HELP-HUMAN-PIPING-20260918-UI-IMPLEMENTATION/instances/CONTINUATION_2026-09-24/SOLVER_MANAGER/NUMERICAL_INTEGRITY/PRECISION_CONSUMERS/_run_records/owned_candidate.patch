+pub fn for_source(source: &Value) -> Result<(&'static Value, &'static str), String> {
+    match source["schema_version"].as_str() {
+        Some("0.1.0") => {
+            if ["producer", "numerical_quality", "formulation_basis"].iter().any(|k| source.get(k).is_some()) {
