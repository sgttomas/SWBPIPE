+    #[test]
+    fn unsupported_gap_inspection_rejects_source_or_receipt_mutations() {
+        for mode in [LinearSolveMode::DenseScrutiny, LinearSolveMode::SparseInteractive] {
+            let input = mixed_product_inspection_input(4);
