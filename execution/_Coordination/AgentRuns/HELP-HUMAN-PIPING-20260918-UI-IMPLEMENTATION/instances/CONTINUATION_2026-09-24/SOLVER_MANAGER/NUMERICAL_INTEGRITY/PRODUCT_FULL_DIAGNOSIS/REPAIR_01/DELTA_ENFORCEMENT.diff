+    #[test]
+    fn product_delta_limits_reject_excess_missing_and_nonfinite_observations() {
+        for limit in [
+            DEC_046_PRODUCT_PREVIEW_TRANSLATION_DELTA_ABSOLUTE_LIMIT_MM / 1000.0,
+            DEC_046_PRODUCT_PREVIEW_ROTATION_DELTA_ABSOLUTE_LIMIT_RAD,
+            DEC_046_PRODUCT_PREVIEW_FORCE_REACTION_DELTA_ABSOLUTE_LIMIT_N,
+            DEC_046_PRODUCT_PREVIEW_MOMENT_REACTION_DELTA_ABSOLUTE_LIMIT_N_M,
+        ] {
+            assert!(product_delta_within_limit(Some(limit), limit, true));
+            assert!(product_delta_within_limit(Some(0.0), limit, true));
+            assert!(!product_delta_within_limit(Some(f64::from_bits(limit.to_bits() + 1)), limit, true));
+            for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY, -1.0] {
+                assert!(!product_delta_within_limit(Some(value), limit, true));
+            }
+            assert!(product_delta_within_limit(None, limit, false));
+            assert!(!product_delta_within_limit(None, limit, true));
+        }
+    }
