+// Product-owned DEC-046 delta limits apply to every selected nonlinear state,
+// whether strictly qualified or retained only for source-bound inspection.
+fn product_selected_delta_limits_satisfied(solve: &NonlinearFrameSolveResult) -> bool {
+    let Some(last) = solve.iterations.last() else { return false; };
+    if solve.iterations.len() > DEC_046_PRODUCT_PREVIEW_ACTIVE_SET_MAX_ITERATIONS {
+        return false;
+    }
+    let has_previous = solve.iterations.len() > 1;
+    let residuals = &last.residuals;
+    [
+        (residuals.max_abs_translation_delta_from_previous,
+         DEC_046_PRODUCT_PREVIEW_TRANSLATION_DELTA_ABSOLUTE_LIMIT_MM / 1000.0),
+        (residuals.max_abs_rotation_delta_from_previous,
+         DEC_046_PRODUCT_PREVIEW_ROTATION_DELTA_ABSOLUTE_LIMIT_RAD),
+        (residuals.max_abs_force_reaction_delta_from_previous,
+         DEC_046_PRODUCT_PREVIEW_FORCE_REACTION_DELTA_ABSOLUTE_LIMIT_N),
+        (residuals.max_abs_moment_reaction_delta_from_previous,
+         DEC_046_PRODUCT_PREVIEW_MOMENT_REACTION_DELTA_ABSOLUTE_LIMIT_N_M),
+    ].into_iter().all(|(value, limit)| product_delta_within_limit(value, limit, has_previous))
+}
+
+fn product_delta_within_limit(value: Option<f64>, limit: f64, has_previous: bool) -> bool {
+    match value {
+        Some(value) => value.is_finite() && value >= 0.0 && value <= limit,
+        None => !has_previous,
     }
 }
 
