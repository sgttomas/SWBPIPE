+#[test]
+fn snapshot_domain_is_explicit_and_does_not_alter_history() {
+    for value in [
+        json!(9_007_199_254_740_993_u64),
+        json!(u64::MAX),
+        json!(i64::MIN),
+        json!(-0.0),
+        json!("\u{ffff}"),
