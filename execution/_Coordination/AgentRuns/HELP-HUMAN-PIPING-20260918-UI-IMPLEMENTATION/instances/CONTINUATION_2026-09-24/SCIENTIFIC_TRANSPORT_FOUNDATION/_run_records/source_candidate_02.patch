+            size += 2
+        elif escaped and point < 0x20:
+            size += 6
+        else:
+            size += 1 if point < 0x80 else 2 if point < 0x800 else 3 if point < 0x10000 else 4
+        if size > maximum:
+            raise ValueError("BINARY64-JSON-BYTE-LIMIT")
+    return size
