+    #[test]
+    fn optional_mass_quantities_preserve_explicit_units_and_warn_on_incomplete_insulation() {
+        let model = bound_test_model();
+        for (key, dimension, unit, value) in [
+            ("material_density", "density", "kg/m^3", 7850.0),
+            ("contents_density", "density", "kg/m^3", 0.0),
+            ("insulation_thickness", "length", "mm", 0.0),
+            ("insulation_density", "density", "kg/m^3", 0.0),
+        ] {
+            let path = format!("section.{key}.value");
+            let intent = modify_intent(
+                "Element",
+                "pipe:P-1",
+                "set_field",
+                &path,
+                "TBD",
+                &json!({"value":value,"unit":unit}).to_string(),
+                unit,
+                dimension,
+            );
+            let out = apply_operation(&model, &intent, None);
+            assert!(out.applied_model.is_some(), "{:?}", out.diagnostics);
+            if key.starts_with("insulation_") {
+                assert!(codes(&out).contains(&"OP-MASS-NOT-SOLVE-READY"));
+            }
+            assert_eq!(
+                out.applied_model.unwrap()["pipe_segments"][0]["section"][key],
+                json!({"value":value,"unit":unit})
+            );
+            for (after, unit, dim) in [
+                (json!({"value":-1,"unit":unit}).to_string(), unit, dimension),
+                (json!({"value":1,"unit":"Pa"}).to_string(), "Pa", dimension),
+                (json!({"value":1,"unit":unit}).to_string(), unit, "stress"),
+            ] {
+                let bad = modify_intent(
+                    "Element",
+                    "pipe:P-1",
+                    "set_field",
+                    &path,
+                    "TBD",
+                    &after,
+                    unit,
+                    dim,
+                );
+                assert!(apply_operation(&model, &bad, None).applied_model.is_none());
+            }
+        }
+        let zero = modify_intent(
+            "Element",
+            "pipe:P-1",
+            "set_field",
+            "section.material_density.value",
+            "TBD",
+            r#"{"value":0,"unit":"kg/m^3"}"#,
+            "kg/m^3",
+            "density",
+        );
+        assert!(apply_operation(&model, &zero, None).applied_model.is_none());
+    }
