+    #[test]
+    fn derived_normal_source_survives_delete_and_scalar_restraint_routes() {
+        let mut model = sample_model();
+        let source = model["supports"][0].clone();
+        let source_id = source["id"].as_str().unwrap();
+        model["supports"].as_array_mut().unwrap().push(json!({"id":"support:derived","label":"Derived","node":source["node"],"restraints":[],"provenance":"user","nonlinear":{"behavior":"friction","dof":"UX","initial_state":"sticking","friction_coefficient":{"value":0.2,"unit":"none"},"normal_reaction_source":{"support_ref":source_id,"dof":"UZ"}}}));
+        let mut deletion = modify_intent(
+            "Support",
+            source_id,
+            "delete_support",
+            "supports",
+            source["label"].as_str().unwrap(),
+            "not_present",
+            "none",
+            "dimensionless",
+        );
+        deletion["operation_kind"] = json!("delete");
+        let before = source["restraints"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v.as_str().unwrap())
+            .collect::<Vec<_>>()
+            .join(", ");
+        let removal = modify_intent(
+            "Support",
+            source_id,
+            "update_support",
+            "restraints",
+            &before,
+            "UX",
+            "none",
+            "dimensionless",
+        );
+        for intent in [deletion, removal] {
+            for outcome in [
+                validate_operation(&model, &intent, None),
+                apply_operation(&model, &intent, None),
+            ] {
+                assert!(outcome.applied_model.is_none());
+                assert!(outcome.diff_preview.is_empty());
+                assert!(outcome
+                    .diagnostics
+                    .iter()
+                    .any(|d| d.code == "OP-SUPPORT-DELETE-REFERENCED"
+                        || d.code == "OP-SUPPORT-DEPENDENT-INVALID"));
+            }
+        }
+        let retained = modify_intent(
+            "Support",
+            source_id,
+            "update_support",
+            "restraints",
+            &before,
+            "UZ",
+            "none",
+            "dimensionless",
+        );
+        assert!(apply_operation(&model, &retained, None)
+            .applied_model
+            .is_some());
+    }
