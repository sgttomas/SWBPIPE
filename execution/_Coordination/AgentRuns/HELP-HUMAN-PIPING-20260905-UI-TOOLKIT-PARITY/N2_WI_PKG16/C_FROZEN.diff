+    #[test]
+    fn entity_deletes_guard_record_staleness_missing_ids_and_all_reference_forms() {
+        for (object_type, collection, id, kind) in [
+            (
+                "Material",
+                "materials",
+                "material:unused",
+                "delete_material",
+            ),
+            ("Section", "sections", "section:test", "delete_section"),
+            (
+                "Component",
+                "components",
+                "component:unused",
+                "delete_component",
+            ),
+        ] {
+            let model = entity_test_model();
+            let input = model.clone();
+            let intent = entity_delete_intent(&model, object_type, collection, id, kind);
+            let preview = validate_operation(&model, &intent, None);
+            assert_eq!(preview.diff_preview.len(), 1);
+            let applied = apply_operation(&model, &intent, None);
+            assert!(applied.applied_model.is_some(), "{:?}", applied.diagnostics);
+            assert!(find_entity(&applied.applied_model.unwrap(), collection, id).is_none());
+            assert_eq!(model, input);
+            let bad_hash = json!({"algorithm":"sha256", "canonicalization":"rfc8785_jcs", "payload_scope":"model_payload", "value":format!("sha256:{}", "0".repeat(64))});
+            assert!(apply_operation(&model, &intent, Some(&bad_hash))
+                .applied_model
+                .is_none());
+            let mut duplicate = model.clone();
+            duplicate[collection]
+                .as_array_mut()
+                .unwrap()
+                .push(find_entity(&model, collection, id).unwrap().clone());
+            assert!(apply_operation(&duplicate, &intent, None)
+                .applied_model
+                .is_none());
+            let mut stale = intent.clone();
+            stale["change"]["before"] = json!("{}");
+            assert!(apply_operation(&model, &stale, None)
+                .applied_model
+                .is_none());
+            let mut missing = intent.clone();
+            missing["target"]["ref"] = json!("missing");
+            assert!(apply_operation(&model, &missing, None)
+                .applied_model
+                .is_none());
+            let mut invalid = intent.clone();
+            invalid["change"]["unit"] = json!("m");
+            assert!(apply_operation(&model, &invalid, None)
+                .applied_model
+                .is_none());
+            let mut invalid = intent.clone();
+            invalid["change"]["after"] = json!("not_present");
+            assert!(apply_operation(&model, &invalid, None)
+                .applied_model
+                .is_none());
+            for reference in [
+                json!({"material":id}),
+                json!({"section_ref":id}),
+                json!({"component_ref":{"object_type":object_type,"ref":id}}),
+                json!({"component_ref":{"object_type":object_type,"id":id}}),
+                json!({"required_input_refs":[id]}),
+                json!({"target_ref":id}),
+            ] {
+                let mut referenced = model.clone();
+                referenced["dependencies"] = json!([reference]);
+                let outcome = apply_operation(&referenced, &intent, None);
+                assert!(codes(&outcome).contains(&"OP-ENTITY-DELETE-REFERENCED"));
+                assert!(outcome.applied_model.is_none());
+            }
+            let mut prose = model.clone();
+            prose["note"] = json!({"label":id,"provenance":id});
+            assert!(apply_operation(&prose, &intent, None)
+                .applied_model
+                .is_some());
+        }
+        let mut model = entity_test_model();
+        let intent = entity_delete_intent(
+            &model,
+            "Material",
+            "materials",
+            "material:unused",
+            "delete_material",
+        );
+        model["load_cases"][0]["modulus_basis_ref"] = json!("temperature:owned");
+        assert!(
+            codes(&apply_operation(&model, &intent, None)).contains(&"OP-ENTITY-DELETE-REFERENCED")
+        );
+    }
