+/// Visit semantic reference slots throughout the document, including canonical
+/// Reference records and dependency arrays. Human labels and prose are not refs.
+fn entity_reference_paths(
+    value: &Value,
+    ids: &[String],
+    path: &str,
+    reference_slot: bool,
+    found: &mut Vec<String>,
+) {
+    match value {
+        Value::String(id) if reference_slot && ids.contains(id) => found.push(path.to_string()),
+        Value::Array(items) => {
+            for (index, item) in items.iter().enumerate() {
+                entity_reference_paths(
+                    item,
+                    ids,
+                    &format!("{path}[{index}]"),
+                    reference_slot,
+                    found,
+                );
+            }
+        }
+        Value::Object(map) => {
+            for (key, item) in map {
+                let is_ref = (key == "id" && (reference_slot || map.contains_key("object_type")))
+                    || key == "ref"
+                    || key.ends_with("_ref")
+                    || key.ends_with("_refs")
+                    || matches!(
+                        key.as_str(),
+                        "material" | "section" | "component" | "required_input_refs"
+                    );
+                entity_reference_paths(item, ids, &format!("{path}.{key}"), is_ref, found);
+            }
+        }
+        _ => {}
+    }
+}
