+#[allow(clippy::too_many_arguments)]
+fn resolve_delete_entity(
+    model: &Value,
+    change_kind: &str,
+    object_type: &str,
+    target_ref: &str,
+    field_path: &str,
+    before: &str,
+    after: &str,
+    unit: &str,
+    dimension: &str,
+    checker: &mut Checker,
+) -> Option<&'static str> {
+    let (expected_type, collection) = match change_kind {
+        "delete_material" => ("Material", "materials"),
+        "delete_section" => ("Section", "sections"),
+        "delete_component" => ("Component", "components"),
+        _ => unreachable!(),
+    };
+    if object_type != expected_type || field_path != collection || after != "deleted" {
+        checker.schema_blocked = true;
+        checker.push("OP-DELETE-ENTITY-SHAPE-INVALID", "blocking", format!("{change_kind} requires {expected_type}, field_path {collection}, and after deleted."), "Refresh the structured delete intent.", vec![target_ref.to_string()]);
+        return None;
+    }
+    if unit != "none" || dimension != "dimensionless" {
+        checker.unit_state = "blocked";
+        checker.push(
+            "OP-DELETE-ENTITY-UNIT-INVALID",
+            "blocking",
+            "Entity deletion requires none/dimensionless metadata.".to_string(),
+            "Refresh the structured delete intent.",
+            vec![target_ref.to_string()],
+        );
+        return None;
+    }
+    checker.unit_state = "passed";
+    let records = model.get(collection).and_then(Value::as_array);
+    let matches = records
+        .map(|rows| {
+            rows.iter()
+                .filter(|row| row.get("id").and_then(Value::as_str) == Some(target_ref))
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    if matches.len() != 1 {
+        checker.reference_state = "blocked";
+        checker.push(
+            "OP-TARGET-NOT-FOUND",
+            "blocking",
+            format!("Deletion requires exactly one `{target_ref}` in {collection}."),
+            "Refresh or repair the model record IDs.",
+            vec![target_ref.to_string()],
+        );
+        return None;
+    }
+    let record = matches[0];
+    check_before(
+        &canonical_json(record),
+        before,
+        target_ref,
+        field_path,
+        checker,
+    );
+    let mut ids = vec![target_ref.to_string()];
+    if collection == "materials" {
+        if let Some(points) = record.get("temperature_points").and_then(Value::as_array) {
+            ids.extend(
+                points
+                    .iter()
+                    .filter_map(|p| p.get("id").and_then(Value::as_str).map(str::to_string)),
+            );
+        }
+    }
+    let mut remainder = model.clone();
+    remainder
+        .get_mut(collection)
+        .and_then(Value::as_array_mut)
+        .unwrap()
+        .retain(|row| row.get("id").and_then(Value::as_str) != Some(target_ref));
+    let mut references = Vec::new();
+    entity_reference_paths(&remainder, &ids, "$", false, &mut references);
+    if !references.is_empty() {
+        checker.reference_state = "blocked";
+        checker.push(
+            "OP-ENTITY-DELETE-REFERENCED",
+            "blocking",
+            format!(
+                "`{target_ref}` or its owned records remain referenced at {}.",
+                references.join(", ")
+            ),
+            "Remove or retarget dependents first; deletion never cascades.",
+            references,
+        );
+        return None;
+    }
+    checker.reference_state = "passed";
+    Some(collection)
+}
