+fn check_section_geometry(section: &Value, target_ref: &str, checker: &mut Checker) {
+    let diameter = section
+        .as_object()
+        .and_then(|record| {
+            dimensioned_quantity(
+                record,
+                &["properties", "outside_diameter"],
+                Dimension::Length,
+                true,
+            )
+        })
+        .and_then(|q| quantity_value_in_unit(&q, "m", Dimension::Length));
+    let wall = section
+        .as_object()
+        .and_then(|record| {
+            dimensioned_quantity(
+                record,
+                &["properties", "wall_thickness"],
+                Dimension::Length,
+                true,
+            )
+        })
+        .and_then(|q| quantity_value_in_unit(&q, "m", Dimension::Length));
+    if section.get("section_type").and_then(Value::as_str) != Some("pipe")
+        || !matches!((diameter, wall), (Some(d), Some(w)) if d.is_finite() && w.is_finite() && w > 0.0 && w < d / 2.0)
+    {
+        checker.push("OP-SECTION-GEOMETRY-INVALID", "blocking", format!("Section `{target_ref}` requires type pipe and accepted length quantities with 0 < wall < outside diameter / 2."), "Correct the section type and geometry before applying the edit.", vec![target_ref.to_string()]);
+    }
+}
