+  pipe.y_reference = { x: 0, y: 1, z: 0 };
+  model.nodes[0].position = { x: 0, y: 0, z: 0 };
+  model.nodes[1].position = { x: 4000, y: 0, z: 0 };
+  model.project.units.length = "mm";
+  return model;
