+                s["hanger"] = json!({"hanger_type":family,"source_reference":"user","constant_load":q(10.,"N"),"travel_range":q(2.,"in")});
+                s
+            }
+            "spring" => {
+                let mut s = support();
+                s["stiffness"] = stiffness("UY", 20., "N/m");
