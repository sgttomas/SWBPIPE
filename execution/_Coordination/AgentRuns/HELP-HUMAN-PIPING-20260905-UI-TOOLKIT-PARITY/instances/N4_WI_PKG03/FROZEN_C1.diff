+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://openpipestress.org/schemas/hanger.schema.yaml",
+  "title": "User supplied hanger library",
+  "description": "Explicit imported values only; import validity does not establish solve readiness. Duplicate hanger_id values are rejected by the import boundary.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "hanger_library",
+    "hanger_records"
+  ],
+  "properties": {
+    "schema_version": {
+      "type": "string",
+      "const": "1.0.0"
+    },
+    "hanger_library": {
+      "$ref": "#/$defs/LibraryMetadata"
+    },
+    "hanger_records": {
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/HangerRecord"
+      }
+    }
+  },
+  "$defs": {
+    "PrivacyClass": {
+      "type": "string",
+      "enum": [
+        "public_schema_only",
+        "public_permissive_reviewed",
+        "private_user_supplied",
+        "project_private",
+        "TBD"
+      ]
+    },
+    "RedistributionStatus": {
+      "type": "string",
+      "enum": [
+        "public_permissive",
+        "private_only",
+        "unknown",
+        "protected_suspected",
+        "rejected",
+        "TBD"
+      ]
+    },
+    "ReviewStatus": {
+      "type": "string",
+      "enum": [
+        "pending",
+        "accepted",
+        "rejected",
+        "quarantined",
+        "TBD"
+      ]
+    },
+    "Text": {
+      "type": "string",
+      "pattern": "\\S"
+    },
+    "Provenance": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "source_name",
+        "source_location",
+        "source_license",
+        "contributor",
+        "contributor_certification",
+        "redistribution_status",
+        "review_status"
+      ],
