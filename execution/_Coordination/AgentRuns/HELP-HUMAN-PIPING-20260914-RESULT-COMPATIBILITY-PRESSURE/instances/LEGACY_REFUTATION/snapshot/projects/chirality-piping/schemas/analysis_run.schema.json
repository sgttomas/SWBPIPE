{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpipestress.org/schemas/analysis_run.schema.json",
  "title": "OpenPipeStress analysis record exact-version dispatcher",
  "oneOf": [
    {
      "allOf": [
        {"type": "object", "required": ["schema_version"], "properties": {"schema_version": {"const": "0.1.0"}}},
        {"oneOf": [{"$ref": "analysis_run.v0.1.schema.json"}, {"$ref": "analysis_run.legacy-desktop.v0.1.schema.json"}]}
      ]
    },
    {
      "allOf": [
        {"type": "object", "required": ["schema_version"], "properties": {"schema_version": {"const": "0.2.0"}}},
        {"$ref": "analysis_run.v0.2.schema.json"}
      ]
    }
  ]
}
